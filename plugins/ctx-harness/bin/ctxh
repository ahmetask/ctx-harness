#!/usr/bin/env python3
"""ctxh: the deterministic half of the ctx-harness plugin. Python 3.10+ stdlib only.

Everything here costs zero LLM tokens. Agents call it instead of exploring,
so only the *answer* enters their context. Repo data lives in <repo>/.ctx/;
a repo opts in by having that directory (the build skill creates it).

  ctxh build-index [--verify] [--quiet]  scan code, mine git, detect commands -> graph.json, commands.json
  ctxh add-command <kind> <cmd> [--replaces <cmd>]   keep a fixed/added command across re-index
  ctxh skeleton                 draft map from the index                -> map.draft.md
  ctxh q <query> [arg]          answer from the index: find, deps, rdeps, impact, cochange,
                                tests, owner, risk, module, hot
  ctxh anchor <card.md>         stamp a card with hashes of the files it describes
  ctxh stale                    what changed since cards / index were built
  ctxh check                    enforce budgets and catch dead paths in map, cards, learned
  ctxh signals                  aggregate agent traces into promotion candidates (curator input)
  ctxh usage <transcript.jsonl> [--label L] [--task T]   tokens/steps of any Claude Code session
  ctxh stats                    harness vs baseline comparison
  ctxh version
  ctxh hook-start | hook-prompt | hook-stop   Claude Code hook entry points

Environment:
  CTXH_DISABLED=1     turn the harness off for a session (baseline runs)
  CTXH_TASK=<name>    label a session's metrics for paired harness/baseline comparisons
  CTXH_REVIEW_GATE=0  skip the Stop-hook check that a reviewer ran after the last code edit
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from collections import Counter, defaultdict
from pathlib import Path


VERSION = "0.1.0"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent


def env(name, default=None):
    """CTXH_* variables, with the older CTX_* spelling accepted too."""
    return os.environ.get(f"CTXH_{name}", os.environ.get(f"CTX_{name}", default))


def find_root() -> Path:
    project = os.environ.get("CLAUDE_PROJECT_DIR")
    if project:
        return Path(project).resolve()
    p = Path.cwd().resolve()
    for d in [p, *p.parents]:
        if (d / ".ctx").is_dir():
            return d
    for d in [p, *p.parents]:
        if (d / ".git").exists():
            return d
    return p


ROOT = find_root()
CTX = ROOT / ".ctx"
GRAPH = CTX / "graph.json"
COMMANDS = CTX / "commands.json"
MAP = CTX / "map.md"
CARDS = CTX / "cards"
LEARNED = CTX / "learned.md"
TRACES = CTX / "traces"
METRICS = CTX / "metrics"
TMP = CTX / "tmp"
PROTOCOL_OVERRIDE = CTX / "protocol.md"
PROTOCOL_DEFAULT = PLUGIN_ROOT / "protocol.md"
CTX_GITIGNORE = "# derived or per-machine; regenerated by ctxh\ngraph.json\ntmp/\ntraces/\nmetrics/\n"
KEEP_RECORDS = 300

OVERHEAD_TASKS = {"bootstrap", "curate"}
BUDGET = {"map_lines": 60, "map_bytes": 4000, "card_lines": 45, "learned_lines": 40}

LANGS = {
    ".py": "python", ".js": "javascript", ".jsx": "javascript", ".mjs": "javascript",
    ".cjs": "javascript", ".ts": "typescript", ".tsx": "typescript", ".go": "go",
    ".java": "java", ".kt": "kotlin", ".rb": "ruby", ".rs": "rust", ".cs": "csharp",
    ".php": "php", ".scala": "scala", ".swift": "swift", ".sh": "shell", ".bash": "shell",
}
SHEBANG_LANGS = {"python": "python", "node": "javascript", "ruby": "ruby",  # extensionless scripts
                 "bash": "shell", "sh": "shell", "zsh": "shell"}
SKIP_DIRS = {".git", ".ctx", ".claude", "node_modules", "vendor", "dist", "build", "target",
             ".venv", "venv", "__pycache__", ".idea", ".vscode", ".next", "coverage", ".gradle", "testdata"}
IGNORE_FILE = ".ctxignore"
CONTAINERS = {"src", "app", "lib", "pkg", "internal", "cmd", "packages", "services", "apps", "modules"}
MANIFESTS = {"package.json", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "go.mod",
             "pom.xml", "build.gradle", "build.gradle.kts", "Cargo.toml", "Gemfile", "composer.json",
             "Makefile", "Dockerfile", "docker-compose.yml", "docker-compose.yaml", "Chart.yaml",
             ".gitlab-ci.yml", "Jenkinsfile", "tsconfig.json"}
ENTRY_NAMES = {"main.py", "__main__.py", "app.py", "main.go", "index.js", "index.ts", "server.js",
               "server.ts", "Main.java", "Application.java", "main.rs"}
RISKY = re.compile(r"\b(revert|hotfix|fix|bug|incident|rollback|regression|outage)\b", re.I)
IMPERATIVE = re.compile(r"\b(always run|make sure to|be sure to|you must|never forget|remember to)\b", re.I)

IMPORT_RX = {
    "python": [re.compile(r"^\s*from\s+(\.*[\w\.]*)\s+import\s", re.M),
               re.compile(r"^\s*import\s+([\w\.]+)", re.M)],
    "javascript": [re.compile(r"""(?:from\s*|import\s*\(\s*|require\s*\(\s*|^import\s+)['"]([^'"]+)['"]""", re.M)],
    "go": [re.compile(r'^\s*(?:\w+\s+)?"([^"]+)"\s*$', re.M)],
    "java": [re.compile(r"^import\s+(?:static\s+)?([\w\.]+)", re.M)],
    "rust": [re.compile(r"^\s*use\s+crate::([\w:]+)", re.M)],
    "ruby": [re.compile(r"""require_relative\s+['"]([^'"]+)['"]""")],
}
IMPORT_RX["typescript"] = IMPORT_RX["javascript"]
IMPORT_RX["kotlin"] = IMPORT_RX["java"]
IMPORT_RX["scala"] = IMPORT_RX["java"]

SYMBOL_RX = {
    "python": re.compile(r"^[ \t]{0,8}(?:async\s+)?(?:def|class)\s+(\w+)", re.M),
    "javascript": re.compile(r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function\*?|class|const|let|interface|type|enum)\s+(\w+)", re.M),
    "go": re.compile(r"^(?:func\s+(?:\([^)]*\)\s*)?|type\s+)(\w+)", re.M),
    "java": re.compile(r"^[ \t]*(?:public|protected|private|static|final|abstract|[ \t])*(?:class|interface|enum|record)\s+(\w+)", re.M),
    "rust": re.compile(r"^[ \t]*(?:pub(?:\([^)]*\))?\s+)?(?:fn|struct|enum|trait|type)\s+(\w+)", re.M),
    "ruby": re.compile(r"^[ \t]*(?:def|class|module)\s+([\w\.]+)", re.M),
    "shell": re.compile(r"^[ \t]*(?:function\s+([\w\-]+)|([\w\-]+)\s*\(\)\s*\{)", re.M),
}
SYMBOL_RX["typescript"] = SYMBOL_RX["javascript"]
SYMBOL_RX["kotlin"] = re.compile(r"^[ \t]*(?:\w+[ \t]+)*(?:fun|class|interface|object)\s+(\w+)", re.M)


# ---------------------------------------------------------------- helpers
def sh(cmd, timeout=60, cwd=None):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), cwd=cwd or ROOT, capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"


def file_sha(path: Path) -> str:
    try:
        return hashlib.sha1(path.read_bytes()).hexdigest()[:12]
    except OSError:
        return "missing"


def load_json(p: Path, default=None):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return default


def write_json(p: Path, data):
    """Atomic write, so a background re-index never leaves a half-written file."""
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=1, sort_keys=True))
    os.replace(tmp, p)


def opted_in() -> bool:
    return CTX.is_dir()


def need_graph():
    g = load_json(GRAPH)
    if not g:
        if not opted_in():
            sys.exit("this repo has no .ctx/ yet: run the ctx-harness build skill (/ctx-harness:build)")
        cmd_build_index(["--quiet"])  # derived cache: rebuild on demand, it is cheap
        g = load_json(GRAPH)
        if not g:
            sys.exit("could not build the index")
    return g


def resolve_arg(g, arg):
    """Accept a full path, a suffix, or a bare filename."""
    files = g["files"]
    if arg in files:
        return arg
    hits = [f for f in files if f.endswith("/" + arg)] or [f for f in files if f.endswith(arg)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        sys.exit(f"no indexed file matches '{arg}'")
    sys.exit("ambiguous, pick one:\n  " + "\n  ".join(sorted(hits)[:10]))


def module_of(path: str) -> str:
    parts = path.split("/")
    if len(parts) == 1:
        return "(root)"
    if parts[0] in CONTAINERS and len(parts) > 2:
        return "/".join(parts[:2])
    return parts[0]


def role_of(path: str, head: str) -> str:
    name = path.rsplit("/", 1)[-1]
    if re.search(r"(^|/)(tests?|spec|__tests__)/", path) or re.match(
            r"(test_.*\.py|.*_test\.(py|go)|.*\.(test|spec)\.[jt]sx?|.*Tests?\.(java|kt))$", name):
        return "test"
    if re.search(r"(_pb2\.py|\.pb\.go|\.min\.js|generated)", path) or re.search(
            r"(Code generated|DO NOT EDIT|@generated)", head):
        return "generated"
    return "src"


def shebang_lang(path: Path):
    """Language of an extensionless script from its shebang line, else None."""
    try:
        with open(path, "rb") as fh:
            first = fh.readline(128).decode(errors="ignore")
    except OSError:
        return None
    if not first.startswith("#!"):
        return None
    words = first[2:].split()
    if words and words[0].rsplit("/", 1)[-1] == "env":  # "#!/usr/bin/env [-S] python3 -u"
        words = [w for w in words[1:] if not w.startswith("-")]
    if not words:
        return None
    return SHEBANG_LANGS.get(re.sub(r"[\d.]+$", "", words[0].rsplit("/", 1)[-1]))


def lang_of(rel: str):
    """Language of a repo file: by suffix, or by shebang for files without one."""
    suffix = Path(rel).suffix
    if suffix:
        return LANGS.get(suffix)
    return shebang_lang(ROOT / rel)


def ignore_rules():
    """Compiled .ctxignore patterns (gitignore syntax: globs, **, trailing /, leading /, ! negation)."""
    try:
        lines = (ROOT / IGNORE_FILE).read_text().splitlines()
    except OSError:
        return []
    rules = []
    for line in lines:
        pat = line.strip()
        if not pat or pat.startswith("#"):
            continue
        negate = pat.startswith("!")
        pat = pat[1:] if negate else pat
        dir_only = pat.endswith("/")
        pat = pat.rstrip("/")
        anchored = "/" in pat  # a leading or middle slash anchors to the repo root
        pat = pat.lstrip("/")
        rx, i = "", 0
        while i < len(pat):
            if pat.startswith("**/", i):
                rx, i = rx + "(?:.*/)?", i + 3
            elif pat.startswith("**", i):
                rx, i = rx + ".*", i + 2
            elif pat[i] == "*":
                rx, i = rx + "[^/]*", i + 1
            elif pat[i] == "?":
                rx, i = rx + "[^/]", i + 1
            elif pat[i] == "[" and "]" in pat[i + 1:]:
                j = pat.index("]", i + 1)
                rx, i = rx + "[" + pat[i + 1:j].replace("!", "^", 1) + "]", j + 1
            else:
                rx, i = rx + re.escape(pat[i]), i + 1
        prefix = "" if anchored else "(?:.*/)?"
        rules.append((re.compile(prefix + rx + ("/" if dir_only else "(?:/|$)")), negate))
    return rules


def ignored(rel: str, rules) -> bool:
    hit = False
    for rx, negate in rules:  # last matching rule wins, as in gitignore
        if rx.match(rel):
            hit = not negate
    return hit


def list_files():
    rules = ignore_rules()
    keep = lambda f: f and not any(part in SKIP_DIRS for part in f.split("/")[:-1]) and \
        not f.startswith((".ctx/", ".claude/")) and not ignored(f, rules)
    if (ROOT / ".git").exists():
        code, out, _ = sh(["git", "ls-files", "-co", "--exclude-standard"])
        if code == 0:
            return [f for f in out.splitlines() if keep(f)]
    out = []
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = [d for d in dns if d not in SKIP_DIRS]
        for fn in fns:
            out.append(os.path.relpath(os.path.join(dp, fn), ROOT).replace(os.sep, "/"))
    return [f for f in out if keep(f)]


# ---------------------------------------------------------------- build-index
def resolve_import(lang, spec, src, fileset, stem_index, go_module):
    cands = []
    if lang == "python":
        dots = len(spec) - len(spec.lstrip("."))
        mod = spec.lstrip(".")
        if dots:
            base = Path(src).parent
            for _ in range(dots - 1):
                base = base.parent
            rel = (base / mod.replace(".", "/")).as_posix() if mod else base.as_posix()
            cands += [rel + ".py", rel + "/__init__.py"]
        else:
            rel = mod.replace(".", "/")
            for prefix in ("", "src/", "lib/"):
                cands += [prefix + rel + ".py", prefix + rel + "/__init__.py"]
    elif lang in ("javascript", "typescript"):
        if spec.startswith("."):
            rel = os.path.normpath(os.path.join(os.path.dirname(src), spec)).replace(os.sep, "/")
        elif spec.startswith(("@/", "~/")):
            rel = "src/" + spec[2:]
        else:
            return []
        exts = ["", ".ts", ".tsx", ".js", ".jsx", ".mjs", "/index.ts", "/index.tsx", "/index.js"]
        cands += [rel + e for e in exts]
    elif lang == "go":
        for mod, prefix in go_module.items():
            if spec.startswith(mod + "/"):
                d = prefix + spec[len(mod) + 1:]
                return sorted(f for f in fileset if f.startswith(d + "/") and f.count("/") == d.count("/") + 1
                              and f.endswith(".go") and not f.endswith("_test.go"))
        return []
    elif lang == "ruby":
        cands += [os.path.normpath(os.path.join(os.path.dirname(src), spec)).replace(os.sep, "/") + ".rb"]
    else:  # java, kotlin, scala, rust: dotted/colon path -> suffix lookup
        key = spec.replace("::", "/").replace(".", "/").lower()
        while key:
            if key in stem_index:
                return stem_index[key]
            key = key.rsplit("/", 1)[0] if "/" in key else ""
        return []
    return [c for c in cands if c in fileset][:1]


def pagerank(nodes, edges, iters=30, d=0.85):
    n = len(nodes) or 1
    rank = {v: 1 / n for v in nodes}
    out = defaultdict(list)
    for a, b in edges:
        out[a].append(b)
    for _ in range(iters):
        nxt = {v: (1 - d) / n for v in nodes}
        for v in nodes:
            targets = out.get(v)
            if targets:
                share = d * rank[v] / len(targets)
                for t in targets:
                    nxt[t] += share
            else:
                for t in nodes:
                    nxt[t] += d * rank[v] / n
        rank = nxt
    return rank


def mine_git(fileset):
    if not (ROOT / ".git").exists():
        return {}, 0
    code, out, _ = sh(["git", "log", "--no-merges", "-n", "500", "--name-only",
                       "--pretty=format:@@%H\x1f%an\x1f%s"], timeout=120)
    if code != 0:
        return {}, 0
    churn, authors, risk = Counter(), defaultdict(Counter), defaultdict(list)
    pairs = Counter()
    commits = 0
    for block in out.split("@@")[1:]:
        lines = block.strip().splitlines()
        if not lines:
            continue
        _, author, subject = (lines[0].split("\x1f") + ["", ""])[:3]
        files = [f for f in lines[1:] if f in fileset]
        commits += 1
        for f in files:
            churn[f] += 1
            authors[f][author] += 1
            if RISKY.search(subject) and len(risk[f]) < 3:
                risk[f].append(subject[:80])
        if 1 < len(files) <= 25:
            for i, a in enumerate(sorted(files)):
                for b in sorted(files)[i + 1:]:
                    pairs[(a, b)] += 1
    hist = {}
    for f in fileset:
        if not churn[f]:
            continue
        total = sum(authors[f].values())
        co = [[b if a == f else a, n] for (a, b), n in pairs.items() if f in (a, b) and n >= 2]
        hist[f] = {
            "churn": churn[f],
            "owners": [[a, round(n / total, 2)] for a, n in authors[f].most_common(2)],
            "risk": risk[f],
            "cochange": sorted(co, key=lambda x: -x[1])[:5],
        }
    return hist, commits


CI_SKIP = re.compile(r"\$\{\{|\b(install|deploy|publish|push|release|login|upload|npm ci|docker|kubectl|helm|"
                     r"terraform|sudo|apt-get|brew|curl|wget)\b")
CI_KINDS = [  # first match wins
    ("test", re.compile(r"\b(unittest|pytest|tox|nox|go test|cargo test|(npm|yarn|pnpm)( run)? test|jest|vitest|"
                        r"mocha|rspec|rake test|mvn( -\S+)* (test|verify)|gradlew? test|ctest|make (test|tests))\b")),
    ("lint", re.compile(r"\b(go vet|golangci-lint|staticcheck|ruff|flake8|pylint|mypy|pyright|black --check|eslint|"
                        r"prettier --check|tsc --noEmit|cargo clippy|cargo fmt --check|gofmt -l|shellcheck|rubocop|"
                        r"(make|npm run|yarn|pnpm) (lint|check|typecheck|vet))\b")),
    ("build", re.compile(r"\b(go build|cargo build|(npm|yarn|pnpm)( run)? build|mvn( -\S+)* package|"
                         r"gradlew? (build|assemble)|make build)\b")),
]


def ci_kind(cmd):
    """test / lint / build for a CI step worth running locally, else None."""
    if CI_SKIP.search(cmd):
        return None
    return next((kind for kind, rx in CI_KINDS if rx.search(cmd)), None)


def ci_run_lines(text):
    """Shell lines of the `run:` steps in a CI workflow, including `run: |` blocks.

    Inside a block, a bare `cd <dir>` line is carried into the lines after it."""
    out, lines, i = [], text.splitlines(), 0
    while i < len(lines):
        m = re.match(r"^(\s*)(?:-\s+)?run:\s*(.*?)\s*$", lines[i])
        i += 1
        if not m:
            continue
        value = m.group(2)
        if not re.fullmatch(r"[|>][-+]?", value):
            if value and not value.startswith("#"):
                out.append(value.strip("\"'"))
            continue
        indent, cd, buf = len(m.group(1)), "", ""
        while i < len(lines) and (not lines[i].strip() or len(lines[i]) - len(lines[i].lstrip()) > indent):
            line = lines[i].strip()
            i += 1
            if not line or line.startswith("#"):
                continue
            if line.endswith("\\"):  # shell line continuation
                buf += line[:-1].strip() + " "
                continue
            line, buf = buf + line, ""
            step = re.fullmatch(r"cd\s+(\S+)", line)
            if step:
                cd = f"cd {step.group(1)} && "
            else:
                out.append(cd + line)
    return out


def detect_commands(files):
    cands = []  # (cmd, kind, source)
    if "Makefile" in files:
        for m in re.finditer(r"^([A-Za-z0-9_\-]+):", (ROOT / "Makefile").read_text(), re.M):
            t = m.group(1)
            kind = {"test": "test", "tests": "test", "lint": "lint", "check": "lint", "vet": "lint",
                    "typecheck": "lint", "build": "build", "fmt": "format", "format": "format"}.get(t)
            if kind:
                cands.append((f"make {t}", kind, "Makefile"))
    if "package.json" in files:
        pj = load_json(ROOT / "package.json", {}) or {}
        runner = "pnpm" if "pnpm-lock.yaml" in files else "yarn" if "yarn.lock" in files else "npm run"
        for s in ("lint", "typecheck", "build", "test"):
            if s in pj.get("scripts", {}):
                cmd = f"{runner} {s}" if runner != "npm run" or s != "test" else "npm test"
                cands.append((cmd, "test" if s == "test" else "build" if s == "build" else "lint", "package.json"))
    for gm in sorted(f for f in files if f == "go.mod" or f.endswith("/go.mod")):
        cd = f"cd {gm[:-len('/go.mod')]} && " if "/" in gm else ""
        cands += [(cd + "go vet ./...", "lint", gm), (cd + "go build ./...", "build", gm),
                  (cd + "go test ./...", "test", gm)]
    if "Cargo.toml" in files:
        cands += [("cargo build", "build", "Cargo.toml"), ("cargo test", "test", "Cargo.toml")]
    py_meta = " ".join((ROOT / f).read_text(errors="ignore") for f in
                       ("pyproject.toml", "requirements.txt", "setup.cfg") if f in files)
    if "pytest" in py_meta:
        cands.append(("python3 -m pytest -q", "test", "pyproject/requirements"))
    ci_runs = []
    for f in sorted(files):
        if f.startswith(".github/workflows/") and f.endswith((".yml", ".yaml")) or f == ".gitlab-ci.yml":
            ci_runs += ci_run_lines((ROOT / f).read_text(errors="ignore"))
    for run in ci_runs:  # CI steps that check the code are candidates too; installs and deploys are not
        kind = ci_kind(run)
        if kind:
            cands.append((run, kind, "ci"))
    seen, result = set(), []
    for cmd, kind, src in cands:
        if cmd in seen:
            continue
        seen.add(cmd)
        result.append({"cmd": cmd, "kind": kind, "source": src, "in_ci": cmd in ci_runs, "verified": None})
    order = {k: i for i, k in enumerate(CMD_KINDS)}
    return sorted(result, key=lambda c: (not c["in_ci"], order.get(c["kind"], 9))), ci_runs


CMD_KINDS = ("format", "lint", "build", "test")


def merge_commands(detected, previous, ci_runs):
    """Detected commands plus the agent's `source: manual` ones, keeping earlier verification results.

    A manual command with `replaces: <cmd>` is a fixed invocation: the detected one it names is dropped."""
    manual = [c for c in previous if c.get("source") == "manual" and c.get("cmd")]
    replaced = {c.get("replaces") for c in manual}
    old = {c["cmd"]: c for c in previous if c.get("cmd")}
    out = [c for c in detected if c["cmd"] not in replaced]
    for c in out:  # a plain re-index keeps earlier verification results
        o = old.get(c["cmd"])
        if o and o.get("verified") is not None:
            c.update({k: o[k] for k in ("verified", "exit", "seconds", "tail") if k in o})
    have = {c["cmd"] for c in out}
    for c in manual:
        if c["cmd"] not in have:
            out.append({**c, "in_ci": c["cmd"] in ci_runs})
    order = {k: i for i, k in enumerate(CMD_KINDS)}
    return sorted(out, key=lambda c: (not c["in_ci"], order.get(c["kind"], 9)))


def verify_command(c):
    t0 = time.time()
    code, out, err = sh(c["cmd"], timeout=600)
    c.update(verified=code == 0, exit=code, seconds=round(time.time() - t0, 1))
    c.pop("tail", None)
    if code != 0:
        c["tail"] = (out + err).strip().splitlines()[-5:]


def cmd_add_command(args):
    """Record a command the agent added or fixed, so re-index keeps it."""
    rest = [a for i, a in enumerate(args) if a not in ("--replaces", "--no-verify")
            and (i == 0 or args[i - 1] != "--replaces")]
    if len(rest) < 2 or rest[0] not in CMD_KINDS:
        sys.exit(f"ctxh add-command {'|'.join(CMD_KINDS)} \"<cmd>\" [--replaces \"<detected cmd>\"] [--no-verify]")
    if not opted_in():
        sys.exit("this repo has no .ctx/ yet: run the ctx-harness build skill (/ctx-harness:build)")
    data = load_json(COMMANDS, {}) or {}
    ci_runs = data.get("ci_runs", [])
    entry = {"cmd": " ".join(rest[1:]), "kind": rest[0], "source": "manual", "verified": None}
    replaces = opt(args, "--replaces")
    if replaces:
        entry["replaces"] = replaces
    entry["in_ci"] = entry["cmd"] in ci_runs
    if "--no-verify" not in args:
        verify_command(entry)
    others = [c for c in data.get("commands", []) if c.get("cmd") not in (entry["cmd"], replaces)]
    data["commands"] = merge_commands([c for c in others if c.get("source") != "manual"], others + [entry], ci_runs)
    write_json(COMMANDS, data)
    state = {True: "verified", False: f"failed (exit {entry.get('exit')})", None: "not verified"}[entry["verified"]]
    print(f"added manual {entry['kind']} command: {entry['cmd']} ({state})"
          + (f"; replaces {replaces}" if replaces else ""))


def cmd_build_index(args):
    t0 = time.time()
    files = list_files()
    fileset = set(files)
    go_module = {}  # module path -> directory prefix ("" for repo root); supports nested go.mod
    for gm in [f for f in files if f == "go.mod" or f.endswith("/go.mod")]:
        m = re.search(r"^module\s+(\S+)", (ROOT / gm).read_text(errors="ignore"), re.M)
        if m:
            go_module[m.group(1)] = gm[:-len("go.mod")]
    lang_by_file = {f: lang for f in files if (lang := lang_of(f))}
    stem_index = defaultdict(list)
    for f in lang_by_file:
        parts = (f.rsplit(".", 1)[0] if Path(f).suffix else f).lower().split("/")
        for i in range(len(parts)):
            stem_index["/".join(parts[i:])].append(f)

    nodes, langs, entry, manifests = {}, Counter(), [], []
    for f in files:
        name = f.rsplit("/", 1)[-1]
        if name in MANIFESTS or f.startswith(".github/workflows/"):
            if f.count("/") <= 3:
                manifests.append(f)
        lang = lang_by_file.get(f)
        if not lang:
            continue
        try:
            text = (ROOT / f).read_text(errors="ignore")
        except OSError:
            continue
        role = role_of(f, text[:400])
        langs[lang] += 1
        if name in ENTRY_NAMES or "__name__ == \"__main__\"" in text or "__name__ == '__main__'" in text \
                or not Path(f).suffix:  # extensionless shebang scripts are run directly
            if role == "src":
                entry.append(f)
        imports = []
        for rx in IMPORT_RX.get(lang, []):
            for spec in rx.findall(text):
                for target in resolve_import(lang, spec, f, fileset, stem_index, go_module):
                    if target != f and target not in imports:
                        imports.append(target)
        symbols = []
        rx = SYMBOL_RX.get(lang)
        if rx:
            for m in rx.finditer(text):
                symbols.append([m.group(m.lastindex), text.count("\n", 0, m.start()) + 1])
        nodes[f] = {"lang": lang, "role": role, "module": module_of(f), "lines": text.count("\n") + 1,
                    "sha": hashlib.sha1(text.encode()).hexdigest()[:12], "imports": imports,
                    "symbols": symbols[:200]}

    for n in nodes.values():  # empty package markers etc. are not worth ranking or describing
        if n["role"] == "src" and not n["symbols"] and n["lines"] <= 3:
            n["role"] = "trivial"
    src = [f for f, n in nodes.items() if n["role"] == "src"]
    edges = [(f, t) for f in src for t in nodes[f]["imports"] if t in nodes and nodes[t]["role"] == "src"]
    rank = pagerank(src, edges)
    for f in src:
        nodes[f]["rank"] = round(rank[f], 4)

    hist, commits = mine_git(set(nodes))
    for f, h in hist.items():
        nodes[f].update(h)

    modules = defaultdict(lambda: {"files": 0, "rank": 0.0, "deps": set(), "rdeps": set(), "tests": set()})
    for f, n in nodes.items():
        m = modules[n["module"]]
        m["files"] += 1
        m["rank"] += n.get("rank", 0)
        for t in n["imports"]:
            tm = nodes[t]["module"]
            if n["role"] == "test":
                modules[tm]["tests"].add(f)
            elif tm != n["module"]:
                m["deps"].add(tm)
                modules[tm]["rdeps"].add(n["module"])
    mods = {k: {"files": v["files"], "rank": round(v["rank"], 4), "deps": sorted(v["deps"]),
                "rdeps": sorted(v["rdeps"]), "tests": sorted(v["tests"])} for k, v in modules.items()}

    commands, ci_runs = detect_commands(fileset)
    commands = merge_commands(commands, (load_json(COMMANDS, {}) or {}).get("commands", []), ci_runs)
    if "--verify" in args:
        for c in commands:
            if c["kind"] != "format":
                verify_command(c)
    _, head, _ = sh(["git", "rev-parse", "--short", "HEAD"])
    graph = {"version": 1, "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S"), "head": head.strip(),
             "commits_mined": commits,
             "stack": {"languages": dict(langs.most_common()), "manifests": sorted(manifests),
                       "entrypoints": sorted(entry)},
             "files": nodes, "modules": mods}
    write_json(GRAPH, graph)
    write_json(COMMANDS, {"commands": commands, "ci_runs": ci_runs})
    if not (CTX / ".gitignore").exists():
        (CTX / ".gitignore").write_text(CTX_GITIGNORE)
    if "--release-lock" in args:
        (TMP / "index.lock").unlink(missing_ok=True)
    if "--quiet" in args:
        return
    ver = [c for c in commands if c.get("verified")]
    print(f"indexed {len(nodes)} code files in {len(mods)} modules, {len(edges)} internal imports, "
          f"{commits} commits mined, {len(commands)} commands ({len(ver)} verified) "
          f"in {time.time() - t0:.1f}s -> .ctx/graph.json, .ctx/commands.json")


# ---------------------------------------------------------------- skeleton
def cmd_skeleton(_):
    g = need_graph()
    cmds = (load_json(COMMANDS, {}) or {}).get("commands", [])
    files, mods = g["files"], g["modules"]
    src_mods = sorted([m for m in mods if any(f["module"] == m and f["role"] == "src" for f in files.values())],
                      key=lambda m: -mods[m]["rank"])
    out = [f"# Repo map  <!-- generated @ {g['head']}; keep under {BUDGET['map_lines']} lines -->", ""]
    langs = ", ".join(f"{k} ({v})" for k, v in g["stack"]["languages"].items())
    out.append(f"Stack: {langs}. Manifests: {', '.join(g['stack']['manifests']) or 'none'}.")
    if g["stack"]["entrypoints"]:
        out.append(f"Entry points: {', '.join(g['stack']['entrypoints'])}.")
    good = [c["cmd"] for c in cmds if c.get("verified")]
    unverified = [c["cmd"] for c in cmds if c.get("verified") is None and c["kind"] != "format"]
    if good:
        out.append("Verified commands: " + " · ".join(f"`{c}`" for c in good) + ".")
    elif unverified:
        out.append("Commands (not verified yet): " + " · ".join(f"`{c}`" for c in unverified) + ".")
    out += ["", "## Modules (most central first)", "", "| module | purpose | key files | depends on |",
            "|---|---|---|---|"]
    for m in src_mods[:12]:
        key = sorted([f for f, n in files.items() if n["module"] == m and n["role"] == "src"],
                     key=lambda f: -files[f].get("rank", 0))[:3]
        key = ", ".join(k.rsplit("/", 1)[-1] for k in key)
        out.append(f"| {m} | TODO(llm) | {key} | {', '.join(mods[m]['deps']) or '-'} |")
    coupling = []
    for f, n in files.items():
        for other, c in n.get("cochange", []):
            o = files.get(other, {})
            if f < other and o.get("module") != n["module"] and n["role"] == o.get("role") == "src":
                linked = other in n["imports"] or f in o.get("imports", [])
                coupling.append((c, f, other, "" if linked else ", no import link"))
    if coupling:
        out += ["", "## Change together (from git history)"]
        for c, a, b, note in sorted(coupling, reverse=True)[:5]:
            out.append(f"- {a} <-> {b} ({c} commits{note})")
    risky = sorted([(len(n.get("risk", [])), f) for f, n in files.items() if n.get("risk")], reverse=True)[:4]
    if risky:
        out += ["", "## Fragile files (fix/revert history)"]
        for _, f in risky:
            out.append(f"- {f}: {files[f]['risk'][0]}")
    out += ["", "## Finding things",
            "- Ask the index first: `ctxh q find|rdeps|impact|cochange|tests|owner|module <arg>`",
            "- Module cards: `.ctx/cards/<module-with-dashes>.md` (open only for the module you touch)",
            "- Gotchas learned from past tasks: `.ctx/learned.md`"]
    (CTX / "map.draft.md").write_text("\n".join(out) + "\n")
    CARDS.mkdir(parents=True, exist_ok=True)
    if not LEARNED.exists():
        LEARNED.write_text("# Learned from past tasks\n"
                           "<!-- Curator-owned. One factual line per entry, each with its evidence. -->\n")
    print(f"wrote .ctx/map.draft.md ({len(out)} lines). Fill TODO(llm) cells, then save as .ctx/map.md")


# ---------------------------------------------------------------- queries
def cmd_q(args):
    if not args:
        sys.exit("usage: ctxh q find|deps|rdeps|impact|cochange|tests|owner|risk|module|hot [arg]")
    g = need_graph()
    files, q, arg = g["files"], args[0], args[1] if len(args) > 1 else None
    if q == "hot":
        n = int(arg or 8)
        for f in sorted([f for f in files if "rank" in files[f]], key=lambda f: -files[f]["rank"])[:n]:
            print(f"{files[f]['rank']:.3f}  {f}")
        return
    if q == "find":
        if not arg:
            sys.exit("ctxh q find <symbol>")
        exact, fuzzy = [], []
        for f, n in files.items():
            for name, line in n["symbols"]:
                if name == arg:
                    exact.append(f"{f}:{line}")
                elif arg.lower() in name.lower():
                    fuzzy.append(f"{f}:{line}  {name}")
        hits = exact or fuzzy
        print("\n".join(hits[:12]) if hits else f"no symbol matching '{arg}' (try grep)")
        return
    if q == "module":
        m = module_of(arg) if arg not in g["modules"] else arg
        if m not in g["modules"]:
            m = files[resolve_arg(g, arg)]["module"]
        info = g["modules"][m]
        card = CARDS / (m.replace("/", "-") + ".md")
        print(f"module {m}: {info['files']} files, depends on {info['deps'] or '-'}, used by {info['rdeps'] or '-'}")
        print(f"tests: {', '.join(info['tests']) or 'none found'}")
        print(f"card: {card.relative_to(ROOT) if card.exists() else 'none yet'}")
        return
    f = resolve_arg(g, arg) if arg else sys.exit(f"ctxh q {q} <file>")
    n = files[f]
    if q == "deps":
        print("\n".join(n["imports"]) or "no internal imports")
    elif q == "rdeps":
        r = [o for o, on in files.items() if f in on["imports"]]
        print("\n".join(sorted(r)) or "nothing imports this file")
    elif q == "impact":
        seen, frontier = {}, [f]
        for depth in (1, 2, 3):
            nxt = []
            for cur in frontier:
                for o, on in files.items():
                    if cur in on["imports"] and o not in seen and o != f:
                        seen[o] = depth
                        nxt.append(o)
            frontier = nxt
        for o, d in sorted(seen.items(), key=lambda x: (x[1], x[0])):
            print(f"{d}  {o}{'  (test)' if files[o]['role'] == 'test' else ''}")
        if not seen:
            print("no dependents")
    elif q == "cochange":
        co = n.get("cochange", [])
        print("\n".join(f"{c}x  {o}" for o, c in co) or "no recurring co-changes in git history")
    elif q == "tests":
        direct = [o for o, on in files.items() if on["role"] == "test" and f in on["imports"]]
        if not direct:
            ups = {o for o, on in files.items() if f in on["imports"]}
            direct = [o for o, on in files.items() if on["role"] == "test" and ups & set(on["imports"])]
        print("\n".join(sorted(direct)) or "no tests import this file (or its direct dependents)")
    elif q == "owner":
        print(", ".join(f"{a} ({int(s * 100)}%)" for a, s in n.get("owners", [])) or "no git history")
    elif q == "risk":
        print("\n".join(n.get("risk", [])) or "no fix/revert commits touch this file")
    else:
        sys.exit(f"unknown query '{q}'")


# ---------------------------------------------------------------- cards
def parse_card(text):
    meta, anchors, body = {}, {}, text
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if m:
        head, body = m.group(1), m.group(2)
        in_anchors = False
        for line in head.splitlines():
            if re.match(r"^anchors:\s*$", line):
                in_anchors = True
            elif in_anchors and line.startswith((" ", "\t", "-")):
                # accept "  path: hash", "  - path", "  path: path" and "  - path: hash"
                item = line.strip().lstrip("-").strip()
                k, _, v = item.partition(":")
                k, v = k.strip().strip("'\""), v.strip().strip("'\"")
                if k in ("path", "file") and v:
                    k, v = v, ""
                if k:
                    anchors[k] = v
            else:
                in_anchors = False
                k, _, v = line.partition(":")
                meta[k.strip()] = v.strip()
    return meta, anchors, body


def render_card(meta, anchors, body):
    head = [f"{k}: {v}" for k, v in meta.items()] + ["anchors:"] + [f"  {k}: {v}" for k, v in anchors.items()]
    return "---\n" + "\n".join(head) + "\n---\n" + body.lstrip("\n")


def cmd_anchor(args):
    if not args:
        sys.exit("ctxh anchor <card.md>")
    card = Path(args[0])
    meta, anchors, body = parse_card(card.read_text())
    if not any((ROOT / a).is_file() for a in anchors) and meta.get("module"):
        g = need_graph()
        anchors = {f: "" for f, n in g["files"].items() if n["module"] == meta["module"] and n["role"] == "src"}
    missing = [a for a in anchors if not (ROOT / a).exists()]
    anchors = {a: file_sha(ROOT / a) for a in anchors if (ROOT / a).exists()}
    meta["updated"] = time.strftime("%Y-%m-%d")
    card.write_text(render_card(meta, anchors, body))
    print(f"anchored {card.name} to {len(anchors)} files" + (f"; dropped missing: {missing}" if missing else ""))


def index_lag(g):
    """Code files committed since the index was built (None if unknown)."""
    if not g or not g.get("head"):
        return None
    code, out, _ = sh(["git", "diff", "--name-only", g["head"], "HEAD"])
    if code != 0:
        return None
    rules = ignore_rules()
    return [f for f in out.splitlines()
            if not f.startswith((".ctx/", ".claude/")) and not ignored(f, rules)
            and (f in g.get("files", {}) or lang_of(f))]  # deleted files count if they were indexed


def stale_report(include_index=True):
    lines = []
    g = load_json(GRAPH)
    if include_index:
        if g is None and opted_in():
            lines.append("no index yet (run `ctxh build-index`, it is cheap)")
        lag = index_lag(g)
        if lag:
            lines.append(f"index predates changes to {len(lag)} code files (run `ctxh build-index`, it is cheap)")
    for card in sorted(CARDS.glob("*.md")) if CARDS.exists() else []:
        meta, anchors, _ = parse_card(card.read_text())
        changed = [a for a, s in anchors.items() if file_sha(ROOT / a) != s]
        new = []
        if g and meta.get("module"):
            new = [f for f, n in g["files"].items()
                   if n["module"] == meta["module"] and n["role"] == "src" and f not in anchors]
        if changed or new:
            why = []
            if changed:
                why.append("changed: " + ", ".join(a.rsplit("/", 1)[-1] for a in changed))
            if new:
                why.append("new files: " + ", ".join(a.rsplit("/", 1)[-1] for a in new))
            lines.append(f"stale card {card.name} ({'; '.join(why)})")
    return lines


def cmd_stale(_):
    print("\n".join(stale_report()) or "everything fresh")


def cmd_check(_):
    problems = []

    def dead_paths(name, text):
        for p in set(re.findall(r"`([\w\-./]+/[\w\-.]+\.\w+)`", text)):
            if not (ROOT / p).exists():
                problems.append(f"{name}: references missing path {p}")

    def phrasing(name, text):
        for m in IMPERATIVE.finditer(text):
            problems.append(f"{name}: instruction-like phrase '{m.group(0)}' (state facts, not orders)")
        if "TODO(llm)" in text:
            problems.append(f"{name}: unfilled TODO(llm)")

    if MAP.exists():
        t = MAP.read_text()
        if t.count("\n") > BUDGET["map_lines"] or len(t) > BUDGET["map_bytes"]:
            problems.append(f"map.md over budget ({t.count(chr(10))} lines, {len(t)} bytes)")
        dead_paths("map.md", t)
        phrasing("map.md", t)
    else:
        problems.append("no .ctx/map.md")
    for card in sorted(CARDS.glob("*.md")) if CARDS.exists() else []:
        t = card.read_text()
        _, anchors, body = parse_card(t)
        if body.count("\n") > BUDGET["card_lines"]:
            problems.append(f"{card.name} over budget ({body.count(chr(10))} lines)")
        if not anchors:
            problems.append(f"{card.name}: no anchors (run ctxh anchor)")
        elif not all(re.fullmatch(r"[0-9a-f]{12}", v) for v in anchors.values()):
            problems.append(f"{card.name}: anchors not stamped (run ctxh anchor {card.relative_to(ROOT)})")
        dead_paths(card.name, body)
        phrasing(card.name, body)
    if LEARNED.exists() and LEARNED.read_text().count("\n") > BUDGET["learned_lines"]:
        problems.append("learned.md over budget: consolidate or prune")
    print("\n".join(problems) or "ok: budgets respected, no dead paths")
    sys.exit(1 if problems else 0)


# ---------------------------------------------------------------- transcripts, traces, metrics
def parse_transcript(path: Path):
    usage_by_msg, tool_uses, results = {}, {}, {}
    if not path.exists():
        return None

    def ingest(p, bucket):
        for line in p.read_text(errors="ignore").splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            msg = e.get("message") or {}
            content = msg.get("content") if isinstance(msg.get("content"), list) else []
            side = bucket if bucket == "sub" or not e.get("isSidechain") else "sub"
            if e.get("type") == "assistant" and msg.get("usage"):
                usage_by_msg[(side, msg.get("id") or e.get("uuid"))] = msg["usage"]
            for c in content:
                if c.get("type") == "tool_use":
                    tool_uses[c.get("id")] = (side, c.get("name"), c.get("input") or {})
                elif c.get("type") == "tool_result":
                    body = c.get("content")
                    if isinstance(body, list):
                        body = " ".join(x.get("text", "") for x in body if isinstance(x, dict))
                    results[c.get("tool_use_id")] = (bool(c.get("is_error")), str(body or "")[:300])

    ingest(path, "main")
    subdir = path.with_suffix("") / "subagents"
    if subdir.is_dir():
        for p in subdir.glob("*.jsonl"):
            ingest(p, "sub")
    tok = {"main": Counter(), "sub": Counter()}
    for (side, _), u in usage_by_msg.items():
        for k in ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"):
            tok[side][k] += u.get(k) or 0
    reads, edits, cmds, failed, ctx_q, misses, agents = [], [], [], [], [], [], Counter()
    for tid, (side, name, inp) in tool_uses.items():
        err, body = results.get(tid, (False, ""))
        if side != "main":
            continue
        if name in ("Read", "NotebookRead"):
            reads.append(inp.get("file_path", ""))
        elif name in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
            edits.append(inp.get("file_path", ""))
        elif name == "Bash":
            c = inp.get("command", "")
            cmds.append(c[:200])
            if re.search(r"(^|[\s/;&|(])ctxh?\s+q\s", c):
                ctx_q.append(c[:120])
                if re.search(r"no (symbol|indexed file|internal)|nothing imports|no tests", body):
                    misses.append(c[:120])
            if err:
                failed.append({"cmd": c[:200], "out": body[:200]})
        elif name in ("Task", "Agent"):
            agents[inp.get("subagent_type", "general")] += 1
    rel = lambda p: os.path.relpath(p, ROOT) if p and os.path.isabs(p) else p

    def total(c):
        return c["input_tokens"] + c["output_tokens"] + c["cache_read_input_tokens"] + c["cache_creation_input_tokens"]

    return {
        "tokens_main": dict(tok["main"]), "tokens_sub": dict(tok["sub"]),
        "tokens_total": total(tok["main"]) + total(tok["sub"]),
        "tokens_uncached": sum(tok[s]["input_tokens"] + tok[s]["output_tokens"] + tok[s]["cache_creation_input_tokens"]
                               for s in tok),
        "steps": sum(1 for s, _, _ in tool_uses.values() if s == "main"),
        "files_read": sorted({rel(p) for p in reads}), "files_edited": sorted({rel(p) for p in edits}),
        "commands": cmds, "failed_commands": failed, "ctx_queries": ctx_q, "ctx_misses": misses,
        "subagents": dict(agents),
    }


def record(session, data, label, task):
    data.update(session=session, label=label, task=task, recorded_at=time.strftime("%Y-%m-%dT%H:%M:%S"))
    write_json(METRICS / f"{session}.json", {k: data[k] for k in (
        "session", "label", "task", "recorded_at", "tokens_total", "tokens_uncached", "tokens_main",
        "tokens_sub", "steps", "subagents")})
    if label == "harness":
        write_json(TRACES / f"{session}.json", {k: data[k] for k in (
            "session", "task", "recorded_at", "files_read", "files_edited", "commands",
            "failed_commands", "ctx_queries", "ctx_misses", "subagents")})
    for d in (METRICS, TRACES):  # bounded history: keep the newest records only
        if d.exists():
            for old in sorted(d.glob("*.json"), key=lambda f: f.stat().st_mtime)[:-KEEP_RECORDS]:
                old.unlink(missing_ok=True)


def opt(args, name, default=None):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else default


def cmd_usage(args):
    if not args:
        sys.exit("ctxh usage <transcript.jsonl> [--label baseline|harness] [--task T]")
    p = Path(args[0]).expanduser()
    data = parse_transcript(p)
    if data is None:
        sys.exit(f"no transcript at {p}")
    label, task = opt(args, "--label", "baseline"), opt(args, "--task", env("TASK"))
    record(p.stem, data, label, task)
    print(f"{label} {task or ''}: {data['tokens_total']} tokens total "
          f"({data['tokens_uncached']} uncached), {data['steps']} tool calls, {len(data['files_read'])} files read")


def cmd_stats(_):
    rows = [load_json(p) for p in METRICS.glob("*.json")] if METRICS.exists() else []
    rows = [r for r in rows if r]
    if not rows:
        print("no metrics yet")
        return

    def med(xs):
        xs = sorted(xs)
        return xs[len(xs) // 2] if xs else 0

    overhead = [r for r in rows if r.get("task") in OVERHEAD_TASKS]
    work = [r for r in rows if r.get("task") not in OVERHEAD_TASKS]
    by = defaultdict(list)
    for r in work:
        by[r["label"]].append(r)
    print(f"{'label':<10}{'runs':>6}{'median tokens':>16}{'median uncached':>18}{'median steps':>14}")
    for label, rs in sorted(by.items()):
        print(f"{label:<10}{len(rs):>6}{med([r['tokens_total'] for r in rs]):>16}"
              f"{med([r['tokens_uncached'] for r in rs]):>18}{med([r['steps'] for r in rs]):>14}")
    tasks = defaultdict(dict)
    for r in work:
        if r.get("task"):
            tasks[r["task"]].setdefault(r["label"], []).append(r["tokens_total"])
    paired = {t: v for t, v in tasks.items() if "harness" in v and "baseline" in v}
    saved = 0
    if paired:
        print("\npaired tasks, median total tokens (harness vs baseline):")
        for t, v in sorted(paired.items()):
            h, b = med(v["harness"]), med(v["baseline"])
            saved += b - h
            print(f"  {t}: {h} vs {b}  ({(h - b) / b * 100:+.0f}%)" if b else f"  {t}: {h} vs {b}")
    if overhead:
        cost = sum(r["tokens_total"] for r in overhead)
        print(f"\nharness overhead so far (bootstrap + curation): {cost} tokens")
        if paired and saved > 0:
            per_task = saved / len(paired)
            print(f"average saving {per_task:.0f} tokens/task -> break-even after ~{cost / per_task:.0f} tasks")
        elif paired:
            print("no net saving on paired tasks yet: the harness is not paying for itself on this repo")


def cmd_signals(_):
    traces = [load_json(p) for p in sorted(TRACES.glob("*.json"))] if TRACES.exists() else []
    traces = [t for t in traces if t and t.get("task") not in OVERHEAD_TASKS]
    if not traces:
        print("no traces yet")
        return
    known = ""
    for p in [MAP, LEARNED, *(CARDS.glob("*.md") if CARDS.exists() else [])]:
        if p.exists():
            known += p.read_text()
    reads = Counter(f for t in traces for f in set(t["files_read"]))
    print(f"{len(traces)} traces")
    print("\nfiles needed in >=3 tasks but not mentioned in map/cards/learned:")
    hits = [(n, f) for f, n in reads.items() if n >= 3 and f.rsplit("/", 1)[-1] not in known]
    print("\n".join(f"  {n}x {f}" for n, f in sorted(hits, reverse=True)[:10]) or "  none")
    fails = Counter(re.sub(r"\s+", " ", x["cmd"])[:80] for t in traces for x in t["failed_commands"])
    print("\ncommands that failed in >=2 tasks:")
    print("\n".join(f"  {n}x {c}" for c, n in fails.most_common(10) if n >= 2) or "  none")
    miss = Counter(m for t in traces for m in t["ctx_misses"])
    print("\nindex queries that came back empty (index gap or wrong mental model):")
    print("\n".join(f"  {n}x {c}" for c, n in miss.most_common(10)) or "  none")
    notes = CTX / "tasks" / "notes.md"
    if notes.exists() and notes.read_text().strip():
        print("\ncoder notes pending review: .ctx/tasks/notes.md")


# ---------------------------------------------------------------- hooks
def refresh_in_background():
    """Start a detached re-index; the session never waits for it."""
    lock = TMP / "index.lock"
    try:
        if lock.exists() and time.time() - lock.stat().st_mtime < 600:
            return
        TMP.mkdir(parents=True, exist_ok=True)
        lock.write_text(str(os.getpid()))
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "build-index", "--quiet", "--release-lock"],
                         cwd=ROOT, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True,
                         env={**os.environ, "CLAUDE_PROJECT_DIR": str(ROOT)})
    except OSError:
        pass


def cmd_hook_start(_):
    try:
        json.load(sys.stdin)
    except ValueError:
        pass
    if env("DISABLED") == "1":
        return
    if not opted_in():
        if (ROOT / ".git").exists():
            print("ctx-harness: this repo has no harness context (.ctx/). "
                  "If the user wants it, the build skill (/ctx-harness:build) creates it.")
        return
    out = []
    proto = PROTOCOL_OVERRIDE if PROTOCOL_OVERRIDE.exists() else PROTOCOL_DEFAULT
    if proto.exists():
        out.append(proto.read_text().strip())
    if MAP.exists():
        out.append(MAP.read_text().strip())
    else:
        out.append("The repo map is missing: run the build skill (/ctx-harness:build) before non-trivial work.")
    g = load_json(GRAPH)
    if g is None or index_lag(g):
        refresh_in_background()  # the index is a derived cache; cards still need the curator
    stale = stale_report(include_index=False)
    if stale:
        out.append("Context freshness (the curator fixes this after merge; do not edit cards yourself):\n"
                   + "\n".join(f"- {x}" for x in stale))
    active = CTX / "tasks" / "active.md"
    if active.exists() and active.read_text().strip():
        out.append("Active plan exists: .ctx/tasks/active.md (read it first).")
    print("\n\n".join(out))


def cmd_hook_prompt(_):
    """Recite the two rules agents most often skip, right where the next decision is made."""
    try:
        json.load(sys.stdin)
    except ValueError:
        pass
    if env("DISABLED") == "1" or not opted_in():
        return
    lines = ["ctx-harness: if this request means changing 3+ files, call ctx-harness:planner first and wait for "
             "the user's approval, however detailed the request is. Before finishing any code change, run "
             "ctx-harness:reviewer, then `ctxh stale`."]
    active = CTX / "tasks" / "active.md"
    if active.exists() and active.read_text().strip():
        lines.append("Active plan: .ctx/tasks/active.md")
    print("\n".join(lines))


def unreviewed_edit(path: Path):
    """Id of the last code edit in the main session that no reviewer call came after, else None."""
    last_edit, reviewed_after = None, False
    try:
        lines = path.read_text(errors="ignore").splitlines()
    except OSError:
        return None
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("isSidechain") or e.get("type") != "assistant":
            continue
        content = (e.get("message") or {}).get("content")
        for c in content if isinstance(content, list) else []:
            if c.get("type") != "tool_use":
                continue
            name, inp = c.get("name"), c.get("input") or {}
            if name in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                f = inp.get("file_path") or inp.get("notebook_path") or ""
                rel = os.path.relpath(f, ROOT) if os.path.isabs(f) else f
                if f and not rel.startswith((".ctx", "..")) and lang_of(rel):
                    last_edit, reviewed_after = c.get("id"), False
            elif name in ("Task", "Agent") and str(inp.get("subagent_type", "")).endswith("reviewer"):
                reviewed_after = True
    return None if reviewed_after else last_edit


def cmd_hook_stop(_):
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if not opted_in():
        return
    tp = payload.get("transcript_path")
    if not tp:
        return
    path = Path(tp).expanduser()
    data = parse_transcript(path)
    if not data:
        return
    disabled = env("DISABLED") == "1"
    session = payload.get("session_id") or path.stem
    record(session, data, "baseline" if disabled else "harness", env("TASK"))
    if disabled or env("REVIEW_GATE", "1") == "0":
        return
    edit = unreviewed_edit(path)
    state = TMP / "gates" / f"{session}.json"
    if edit and (load_json(state, {}) or {}).get("blocked_edit") != edit:
        write_json(state, {"blocked_edit": edit})  # block once per edit, never loop
        print(json.dumps({"decision": "block", "reason": (
            "ctx-harness review gate: code changed since the last ctx-harness:reviewer run. Run the reviewer "
            "on the diff (at most 2 rounds), record its findings in the plan's progress log, run `ctxh stale`, "
            "then finish. If the user explicitly said to skip review, say so and finish.")}))


def cmd_version(_):
    print(f"ctxh {VERSION} (plugin root: {PLUGIN_ROOT}, repo root: {ROOT})")


COMMANDS_MAP = {
    "build-index": cmd_build_index, "skeleton": cmd_skeleton, "q": cmd_q, "anchor": cmd_anchor,
    "stale": cmd_stale, "check": cmd_check, "signals": cmd_signals, "usage": cmd_usage,
    "stats": cmd_stats, "add-command": cmd_add_command, "hook-start": cmd_hook_start, "hook-stop": cmd_hook_stop,
    "hook-prompt": cmd_hook_prompt, "version": cmd_version,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS_MAP:
        print(__doc__)
        sys.exit(0 if len(sys.argv) < 2 else 2)
    try:
        COMMANDS_MAP[sys.argv[1]](sys.argv[2:])
    except BrokenPipeError:
        pass
