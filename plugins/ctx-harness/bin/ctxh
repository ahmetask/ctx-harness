#!/usr/bin/env python3
"""ctxh: the deterministic half of the ctx-harness plugin. Python 3.10+ stdlib only.

Everything here costs zero LLM tokens. Agents call it instead of exploring,
so only the *answer* enters their context. Repo data lives in <repo>/.ctx/;
a repo opts in by having that directory (the build skill creates it).

  ctxh build-index [--verify] [--quiet]  scan code, mine git, detect commands -> graph.json, commands.json
  ctxh add-command <kind> <cmd> [--replaces <cmd>]   keep a fixed/added command across re-index
  ctxh skeleton                 draft map from the index                -> map.draft.md
  ctxh q <query> [arg]          answer from the index: find, search, deps, rdeps, impact, cochange,
                                tests, owner, risk, module, hot
  ctxh anchor <card.md>         stamp a card with hashes of the files it describes
  ctxh stale                    what changed since cards / index were built
  ctxh check                    enforce budgets and catch dead paths in map, cards, learned
  ctxh card-draft <module>      write a card with the index's facts; the writer adds only invariants
  ctxh ready                    one verdict: is this repo's context usable (blocking vs warnings)
  ctxh signals                  aggregate agent traces into promotion candidates (curator input)
  ctxh usage <transcript> [--label L] [--task T]   tokens/steps of any agent session
  ctxh stats                    harness vs baseline comparison
  ctxh init --target agents-md|gemini|cursor|aider   point another agent's instructions file at .ctx/
  ctxh review-record [paths]    record that the current content of changed code files was reviewed
  ctxh review-check [--staged | --base REF] [--install-hook]   fail on code changes with no review record
  ctxh version
  ctxh export --tool NAME [--out DIR] [--check]   write an agent's agent/skill files from prompts/
  ctxh hook-start | hook-prompt | hook-stop [--tool NAME]   agent hook entry points

The engine is tool-neutral. What a coding agent hands its hooks, how a hook answers and what a
session transcript looks like live in an adapter (adapters/<tool>.py, see adapters/README.md).

Environment:
  CTXH_DISABLED=1     turn the harness off for a session (baseline runs)
  CTXH_TASK=<name>    label a session's metrics for paired harness/baseline comparisons
  CTXH_REVIEW_GATE=1  opt in: the Stop hook blocks once when code changed and no reviewer ran after the last edit
  CTXH_PLAN_GATE=1    opt in: the Stop hook blocks once when 3+ code files changed with no plan
                      (both are off by default: they cost a model turn plus a subagent per task;
                      CTXH_REVIEW_GATE=0 also switches off `ctxh review-check`)
  CTXH_TOOL=<name>    agent adapter to use (default: claude)
  CTXH_PARSER=regex   ignore tree-sitter even when it is installed
  CTXH_TRACE_SINK=<dir | http(s)://url | redis://host[:port][/db]>   also send traces there; signals reads it
  CTXH_TRACE_REPO=<name>   repo key in the shared sink (default: origin URL)
"""
import contextlib
import hashlib
import io
import math
import importlib
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
from collections import Counter, defaultdict
from pathlib import Path


VERSION = "0.4.0"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent


def env(name, default=None):
    """CTXH_* variables, with the older CTX_* spelling accepted too."""
    return os.environ.get(f"CTXH_{name}", os.environ.get(f"CTX_{name}", default))


def load_adapter(name):
    """The agent adapter module adapters/<name>.py; the engine talks to the agent only through it."""
    path = PLUGIN_ROOT / "adapters" / f"{name}.py"
    if not re.fullmatch(r"[a-z0-9_]+", name or "") or not path.is_file():
        have = sorted(p.stem for p in (PLUGIN_ROOT / "adapters").glob("*.py"))
        sys.exit(f"ctxh: no adapter '{name}' (CTXH_TOOL or --tool); available: {', '.join(have) or 'none'}")
    spec = importlib.util.spec_from_file_location(f"ctxh_adapter_{name}", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def adapter_name():
    """Hook commands and export take `--tool <name>` (some agents clean the hook environment); else CTXH_TOOL."""
    a = sys.argv
    if len(a) > 2 and (a[1].startswith("hook-") or a[1] == "export") and "--tool" in a[2:-1]:
        return a[a.index("--tool", 2) + 1]
    return env("TOOL", "claude")


ADAPTER = load_adapter(adapter_name())


def find_root() -> Path:
    project = ADAPTER.project_dir()
    if project:
        return Path(project).resolve()
    p = Path.cwd().resolve()
    for d in [p, *p.parents]:
        if (d / ".ctx").is_dir():
            return d
    for d in [p, *p.parents]:
        if (d / ".git").exists():
            return d
    return p


ROOT = find_root()
CTX = ROOT / ".ctx"
GRAPH = CTX / "graph.json"
COMMANDS = CTX / "commands.json"
MAP = CTX / "map.md"
CARDS = CTX / "cards"
LEARNED = CTX / "learned.md"
TRACES = CTX / "traces"
METRICS = CTX / "metrics"
TMP = CTX / "tmp"
REVIEWS = CTX / "reviews.json"  # opt-in review record: code path -> git blob id of the reviewed content
PROTOCOL_OVERRIDE = CTX / "protocol.md"
PROTOCOL_DEFAULT = PLUGIN_ROOT / "protocol.md"
CTX_GITIGNORE = "# derived or per-machine; regenerated by ctxh\ngraph.json\ntmp/\ntraces/\nmetrics/\n"
KEEP_RECORDS = 300
PLAN_TAIL = 8  # progress-log entries repeated to a session resuming after compaction

OVERHEAD_TASKS = {"bootstrap", "curate"}
PLAN_GATE_FILES = 3  # "plan before touching 3+ files", the rule the protocol states and the Stop hook checks
BUDGET = {"map_lines": 60, "map_bytes": 4000, "card_lines": 45, "learned_lines": 40}

LANGS = {
    ".py": "python", ".js": "javascript", ".jsx": "javascript", ".mjs": "javascript",
    ".cjs": "javascript", ".ts": "typescript", ".tsx": "typescript", ".go": "go",
    ".java": "java", ".kt": "kotlin", ".rb": "ruby", ".rs": "rust", ".cs": "csharp",
    ".php": "php", ".scala": "scala", ".swift": "swift", ".sh": "shell", ".bash": "shell",
}
SHEBANG_LANGS = {"python": "python", "node": "javascript", "ruby": "ruby",  # extensionless scripts
                 "bash": "shell", "sh": "shell", "zsh": "shell"}
SKIP_DIRS = {".git", ".ctx", ".claude", "node_modules", "vendor", "dist", "build", "target",
             ".venv", "venv", "__pycache__", ".idea", ".vscode", ".next", "coverage", ".gradle", "testdata"}
IGNORE_FILE = ".ctxignore"
CONTAINERS = {"src", "app", "lib", "pkg", "internal", "cmd", "packages", "services", "apps", "modules"}
MANIFESTS = {"package.json", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "go.mod",
             "pom.xml", "build.gradle", "build.gradle.kts", "Cargo.toml", "Gemfile", "composer.json",
             "Makefile", "Dockerfile", "docker-compose.yml", "docker-compose.yaml", "Chart.yaml",
             ".gitlab-ci.yml", "Jenkinsfile", "tsconfig.json"}
# A directory holding one of these is a package, and so a module (build and CI files are not).
PACKAGE_MANIFESTS = {"package.json", "pyproject.toml", "setup.py", "setup.cfg", "go.mod", "pom.xml", "build.gradle",
                     "build.gradle.kts", "Cargo.toml", "Gemfile", "composer.json", "Chart.yaml",
                     ".claude-plugin/plugin.json"}
DOC_LANGS = {".md": "markdown", ".mdx": "markdown"}  # indexed as role "docs": headings, no imports, no gates
HEADING_RX = re.compile(r"^#{1,6}[ \t]+(.+?)[ \t#]*$", re.M)
ENTRY_NAMES = {"main.py", "__main__.py", "app.py", "main.go", "index.js", "index.ts", "server.js",
               "server.ts", "Main.java", "Application.java", "main.rs"}
RISKY = re.compile(r"\b(revert|hotfix|fix|bug|incident|rollback|regression|outage)\b", re.I)
IMPERATIVE = re.compile(r"\b(always run|make sure to|be sure to|you must|never forget|remember to)\b", re.I)

IMPORT_RX = {
    "python": [re.compile(r"^\s*from\s+(\.*[\w\.]*)\s+import\s", re.M),
               re.compile(r"^\s*import\s+([\w\.]+)", re.M)],
    "javascript": [re.compile(r"""(?:from\s*|import\s*\(\s*|require\s*\(\s*|^import\s+)['"]([^'"]+)['"]""", re.M)],
    "go": [re.compile(r'^\s*(?:\w+\s+)?"([^"]+)"\s*$', re.M)],
    "java": [re.compile(r"^import\s+(?:static\s+)?([\w\.]+)", re.M)],
    "rust": [re.compile(r"^\s*use\s+crate::([\w:]+)", re.M)],
    "ruby": [re.compile(r"""require_relative\s+['"]([^'"]+)['"]""")],
}
IMPORT_RX["typescript"] = IMPORT_RX["javascript"]
IMPORT_RX["kotlin"] = IMPORT_RX["java"]
IMPORT_RX["scala"] = IMPORT_RX["java"]

SYMBOL_RX = {
    "python": re.compile(r"^[ \t]{0,8}(?:async\s+)?(?:def|class)\s+(\w+)", re.M),
    "javascript": re.compile(r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function\*?|class|const|let|interface|type|enum)\s+(\w+)", re.M),
    "go": re.compile(r"^(?:func\s+(?:\([^)]*\)\s*)?|type\s+)(\w+)", re.M),
    "java": re.compile(r"^[ \t]*(?:public|protected|private|static|final|abstract|[ \t])*(?:class|interface|enum|record)\s+(\w+)", re.M),
    "rust": re.compile(r"^[ \t]*(?:pub(?:\([^)]*\))?\s+)?(?:fn|struct|enum|trait|type)\s+(\w+)", re.M),
    "ruby": re.compile(r"^[ \t]*(?:def|class|module)\s+([\w\.]+)", re.M),
    "shell": re.compile(r"^[ \t]*(?:function\s+([\w\-]+)|([\w\-]+)\s*\(\)\s*\{)", re.M),
}
SYMBOL_RX["typescript"] = SYMBOL_RX["javascript"]
SYMBOL_RX["kotlin"] = re.compile(r"^[ \t]*(?:\w+[ \t]+)*(?:fun|class|interface|object)\s+(\w+)", re.M)

# ---------------------------------------------------------------- helpers
def sh(cmd, timeout=60, cwd=None):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), cwd=cwd or ROOT, capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"


def file_sha(path: Path) -> str:
    try:
        return hashlib.sha1(path.read_bytes()).hexdigest()[:12]
    except OSError:
        return "missing"


def load_json(p: Path, default=None):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return default


def write_json(p: Path, data):
    """Atomic write, so a background re-index never leaves a half-written file."""
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=1, sort_keys=True))
    os.replace(tmp, p)


def opted_in() -> bool:
    return CTX.is_dir()


def need_graph():
    g = load_json(GRAPH)
    if not g:
        if not opted_in():
            sys.exit(render_prompt("this repo has no .ctx/ yet: run the ctx-harness build skill ({{command:build}})"))
        cmd_build_index(["--quiet"])  # derived cache: rebuild on demand, it is cheap
        g = load_json(GRAPH)
        if not g:
            sys.exit("could not build the index")
    return g


def resolve_arg(g, arg):
    """Accept a full path, a suffix, or a bare filename."""
    files = g["files"]
    if arg in files:
        return arg
    hits = [f for f in files if f.endswith("/" + arg)] or [f for f in files if f.endswith(arg)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        sys.exit(f"no indexed file matches '{arg}'")
    sys.exit("ambiguous, pick one:\n  " + "\n  ".join(sorted(hits)[:10]))


def package_roots(files):
    """Directories below the repo root that hold a package manifest, deepest first."""
    roots = set()
    for f in files:
        for m in PACKAGE_MANIFESTS:
            if f.endswith("/" + m):
                roots.add(f[:-len(m) - 1])
    return sorted(roots, key=lambda r: (-r.count("/"), r))


def module_of(path: str, roots=()) -> str:
    """The deepest package root holding the file, then one level more below a container dir like src/.

    Outside any package root the repo root acts as one: its first folder, or two under a container."""
    base = next((r for r in roots if path.startswith(r + "/")), "")
    parts = path[len(base) + 1 if base else 0:].split("/")
    if len(parts) == 1:
        return base or "(root)"
    if parts[0] in CONTAINERS and len(parts) > 2:
        sub = "/".join(parts[:2])
    elif base:
        return base
    else:
        sub = parts[0]
    return f"{base}/{sub}" if base else sub


def role_of(path: str, head: str) -> str:
    name = path.rsplit("/", 1)[-1]
    if re.search(r"(^|/)(tests?|spec|__tests__)/", path) or re.match(
            r"(test_.*\.py|.*_test\.(py|go)|.*\.(test|spec)\.[jt]sx?|.*Tests?\.(java|kt))$", name):
        return "test"
    if re.search(r"(_pb2\.py|\.pb\.go|\.min\.js|generated)", path) or re.search(
            r"(Code generated|DO NOT EDIT|@generated)", head):
        return "generated"
    return "src"


def shebang_lang(path: Path):
    """Language of an extensionless script from its shebang line, else None."""
    try:
        with open(path, "rb") as fh:
            first = fh.readline(128).decode(errors="ignore")
    except OSError:
        return None
    if not first.startswith("#!"):
        return None
    words = first[2:].split()
    if words and words[0].rsplit("/", 1)[-1] == "env":  # "#!/usr/bin/env [-S] python3 -u"
        words = [w for w in words[1:] if not w.startswith("-")]
    if not words:
        return None
    return SHEBANG_LANGS.get(re.sub(r"[\d.]+$", "", words[0].rsplit("/", 1)[-1]))


def lang_of(rel: str):
    """Language of a repo file: by suffix, or by shebang for files without one."""
    suffix = Path(rel).suffix
    if suffix:
        return LANGS.get(suffix)
    return shebang_lang(ROOT / rel)


def ignore_rules():
    """Compiled .ctxignore patterns (gitignore syntax: globs, **, trailing /, leading /, ! negation)."""
    try:
        lines = (ROOT / IGNORE_FILE).read_text().splitlines()
    except OSError:
        return []
    rules = []
    for line in lines:
        pat = line.strip()
        if not pat or pat.startswith("#"):
            continue
        negate = pat.startswith("!")
        pat = pat[1:] if negate else pat
        dir_only = pat.endswith("/")
        pat = pat.rstrip("/")
        anchored = "/" in pat  # a leading or middle slash anchors to the repo root
        pat = pat.lstrip("/")
        rx, i = "", 0
        while i < len(pat):
            if pat.startswith("**/", i):
                rx, i = rx + "(?:.*/)?", i + 3
            elif pat.startswith("**", i):
                rx, i = rx + ".*", i + 2
            elif pat[i] == "*":
                rx, i = rx + "[^/]*", i + 1
            elif pat[i] == "?":
                rx, i = rx + "[^/]", i + 1
            elif pat[i] == "[" and "]" in pat[i + 1:]:
                j = pat.index("]", i + 1)
                rx, i = rx + "[" + pat[i + 1:j].replace("!", "^", 1) + "]", j + 1
            else:
                rx, i = rx + re.escape(pat[i]), i + 1
        prefix = "" if anchored else "(?:.*/)?"
        rules.append((re.compile(prefix + rx + ("/" if dir_only else "(?:/|$)")), negate))
    return rules


def ignored(rel: str, rules) -> bool:
    hit = False
    for rx, negate in rules:  # last matching rule wins, as in gitignore
        if rx.match(rel):
            hit = not negate
    return hit


def list_files():
    rules = ignore_rules()
    keep = lambda f: f and not any(part in SKIP_DIRS for part in f.split("/")[:-1]) and \
        not f.startswith((".ctx/", ".claude/")) and not ignored(f, rules)
    if (ROOT / ".git").exists():
        code, out, _ = sh(["git", "ls-files", "-co", "--exclude-standard"])
        if code == 0:
            return [f for f in out.splitlines() if keep(f)]
    out = []
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = [d for d in dns if d not in SKIP_DIRS]
        for fn in fns:
            out.append(os.path.relpath(os.path.join(dp, fn), ROOT).replace(os.sep, "/"))
    return [f for f in out if keep(f)]


# ---------------------------------------------------------------- optional tree-sitter parsing
# Used when the `tree_sitter` package and a language's grammar package are importable (and CTXH_PARSER is not
# "regex"); anything missing or failing falls back to the regexes above, so stdlib-only stays the default.
TS_GRAMMARS = {"python": ("tree_sitter_python", "language"), "go": ("tree_sitter_go", "language"),
               "javascript": ("tree_sitter_javascript", "language"),
               "typescript": ("tree_sitter_typescript", "language_typescript"),
               "tsx": ("tree_sitter_typescript", "language_tsx"), "java": ("tree_sitter_java", "language"),
               "rust": ("tree_sitter_rust", "language"), "ruby": ("tree_sitter_ruby", "language")}
_JS_DEFS = {"function_declaration", "generator_function_declaration", "class_declaration", "method_definition",
            "variable_declarator"}
TS_DEFS = {
    "python": {"function_definition", "class_definition"},
    "go": {"function_declaration", "method_declaration", "type_spec"},
    "javascript": _JS_DEFS,
    "typescript": _JS_DEFS | {"abstract_class_declaration", "interface_declaration", "type_alias_declaration",
                              "enum_declaration"},
    "java": {"class_declaration", "interface_declaration", "enum_declaration", "record_declaration",
             "method_declaration", "constructor_declaration"},
    "rust": {"function_item", "struct_item", "enum_item", "trait_item", "type_item"},
    "ruby": {"method", "singleton_method", "class", "module"},
}
_TS_PARSERS = {}


def ts_parser(lang, path):
    """A tree-sitter parser for this file's language, or None (package, grammar or API unavailable)."""
    if env("PARSER", "auto") == "regex":
        return None
    key = "tsx" if lang == "typescript" and path.endswith(".tsx") else lang
    if key not in _TS_PARSERS:
        _TS_PARSERS[key] = None
        try:
            import tree_sitter
            mod_name, fn = TS_GRAMMARS[key]
            grammar = getattr(importlib.import_module(mod_name), fn)()
            _TS_PARSERS[key] = tree_sitter.Parser(tree_sitter.Language(grammar))
        except Exception:  # not installed, unknown language, or an incompatible tree_sitter API
            pass
    return _TS_PARSERS[key]


def ts_extract(lang, path, text):
    """(import specs, [[symbol, line], ...]) from a syntax tree, in the regex path's format; None to fall back."""
    parser = ts_parser(lang, path)
    if parser is None:
        return None
    try:
        src = text.encode()
        root = parser.parse(src).root_node
    except Exception:
        return None
    node_text = lambda n: src[n.start_byte:n.end_byte].decode(errors="ignore")
    unquote = lambda n: node_text(n).strip("\"'`")
    defs, specs, symbols, stack = TS_DEFS[lang], [], [], [root]
    while stack:
        n = stack.pop()
        t = n.type
        if t in defs:
            if t == "variable_declarator":  # only module-level const/let, as the regex has it
                decl = n.parent
                top = decl.parent if decl is not None else None
                if top is None or not (top.type == "program" or (top.type == "export_statement"
                                                                 and top.parent is not None
                                                                 and top.parent.type == "program")):
                    stack.extend(reversed(n.children))
                    continue
            name = n.child_by_field_name("name")
            if name is not None and name.type in ("identifier", "type_identifier", "field_identifier",
                                                  "property_identifier", "constant", "scope_resolution"):
                symbols.append([node_text(name), n.start_point[0] + 1])
        if lang == "python" and t == "import_statement":
            for c in n.named_children:
                target = c.child_by_field_name("name") if c.type == "aliased_import" else c
                if target is not None and target.type == "dotted_name":
                    specs.append(node_text(target))
        elif lang == "python" and t == "import_from_statement":
            mod = n.child_by_field_name("module_name")
            if mod is not None:
                specs.append(node_text(mod))
        elif lang == "go" and t == "import_spec":
            path_node = n.child_by_field_name("path")
            if path_node is not None:
                specs.append(unquote(path_node))
        elif lang in ("javascript", "typescript") and t in ("import_statement", "export_statement"):
            source = n.child_by_field_name("source")
            if source is not None:
                specs.append(unquote(source))
        elif lang in ("javascript", "typescript") and t == "call_expression":
            fn, args = n.child_by_field_name("function"), n.child_by_field_name("arguments")
            if fn is not None and node_text(fn) in ("require", "import") and args is not None:
                first = next((a for a in args.named_children if a.type in ("string", "template_string")), None)
                if first is not None:
                    specs.append(unquote(first))
        elif lang == "java" and t == "import_declaration":
            target = next((c for c in n.named_children if c.type in ("scoped_identifier", "identifier")), None)
            if target is not None:
                specs.append(node_text(target))
        elif lang == "rust" and t == "use_declaration":
            m = re.match(r"crate::([\w:]+)", node_text(n.child_by_field_name("argument") or n))
            if m:
                specs.append(m.group(1).rstrip(":"))
        elif lang == "ruby" and t == "call":
            method, args = n.child_by_field_name("method"), n.child_by_field_name("arguments")
            if method is not None and node_text(method) == "require_relative" and args is not None:
                first = next((a for a in args.named_children if a.type == "string"), None)
                if first is not None:
                    specs.append(unquote(first))
        stack.extend(reversed(n.children))
    symbols.sort(key=lambda x: x[1])
    return specs, symbols


# ---------------------------------------------------------------- build-index
def resolve_import(lang, spec, src, fileset, stem_index, go_module):
    cands = []
    if lang == "python":
        dots = len(spec) - len(spec.lstrip("."))
        mod = spec.lstrip(".")
        if dots:
            base = Path(src).parent
            for _ in range(dots - 1):
                base = base.parent
            rel = (base / mod.replace(".", "/")).as_posix() if mod else base.as_posix()
            cands += [rel + ".py", rel + "/__init__.py"]
        else:
            rel = mod.replace(".", "/")
            for prefix in ("", "src/", "lib/"):
                cands += [prefix + rel + ".py", prefix + rel + "/__init__.py"]
    elif lang in ("javascript", "typescript"):
        if spec.startswith("."):
            rel = os.path.normpath(os.path.join(os.path.dirname(src), spec)).replace(os.sep, "/")
        elif spec.startswith(("@/", "~/")):
            rel = "src/" + spec[2:]
        else:
            return []
        exts = ["", ".ts", ".tsx", ".js", ".jsx", ".mjs", "/index.ts", "/index.tsx", "/index.js"]
        cands += [rel + e for e in exts]
    elif lang == "go":
        for mod, prefix in go_module.items():
            if spec.startswith(mod + "/"):
                d = prefix + spec[len(mod) + 1:]
                return sorted(f for f in fileset if f.startswith(d + "/") and f.count("/") == d.count("/") + 1
                              and f.endswith(".go") and not f.endswith("_test.go"))
        return []
    elif lang == "ruby":
        cands += [os.path.normpath(os.path.join(os.path.dirname(src), spec)).replace(os.sep, "/") + ".rb"]
    else:  # java, kotlin, scala, rust: dotted/colon path -> suffix lookup
        key = spec.replace("::", "/").replace(".", "/").lower()
        while key:
            if key in stem_index:
                return stem_index[key]
            key = key.rsplit("/", 1)[0] if "/" in key else ""
        return []
    return [c for c in cands if c in fileset][:1]


def pagerank(nodes, edges, iters=30, d=0.85):
    n = len(nodes) or 1
    rank = {v: 1 / n for v in nodes}
    out = defaultdict(list)
    for a, b in edges:
        out[a].append(b)
    for _ in range(iters):
        nxt = {v: (1 - d) / n for v in nodes}
        for v in nodes:
            targets = out.get(v)
            if targets:
                share = d * rank[v] / len(targets)
                for t in targets:
                    nxt[t] += share
            else:
                for t in nodes:
                    nxt[t] += d * rank[v] / n
        rank = nxt
    return rank


def mine_git(fileset):
    if not (ROOT / ".git").exists():
        return {}, 0
    code, out, _ = sh(["git", "log", "--no-merges", "-n", "500", "--name-only",
                       "--pretty=format:@@%H\x1f%an\x1f%s"], timeout=120)
    if code != 0:
        return {}, 0
    churn, authors, risk = Counter(), defaultdict(Counter), defaultdict(list)
    pairs = Counter()
    commits = 0
    for block in out.split("@@")[1:]:
        lines = block.strip().splitlines()
        if not lines:
            continue
        _, author, subject = (lines[0].split("\x1f") + ["", ""])[:3]
        files = [f for f in lines[1:] if f in fileset]
        commits += 1
        for f in files:
            churn[f] += 1
            authors[f][author] += 1
            if RISKY.search(subject) and len(risk[f]) < 3:
                risk[f].append(subject[:80])
        if 1 < len(files) <= 25:
            for i, a in enumerate(sorted(files)):
                for b in sorted(files)[i + 1:]:
                    pairs[(a, b)] += 1
    hist = {}
    for f in fileset:
        if not churn[f]:
            continue
        total = sum(authors[f].values())
        co = [[b if a == f else a, n] for (a, b), n in pairs.items() if f in (a, b) and n >= 2]
        hist[f] = {
            "churn": churn[f],
            "owners": [[a, round(n / total, 2)] for a, n in authors[f].most_common(2)],
            "risk": risk[f],
            "cochange": sorted(co, key=lambda x: -x[1])[:5],
        }
    return hist, commits


CI_SKIP = re.compile(r"\$\{\{|\b(install|deploy|publish|push|release|login|upload|npm ci|docker|kubectl|helm|"
                     r"terraform|sudo|apt-get|brew|curl|wget)\b")
CI_KINDS = [  # first match wins
    ("test", re.compile(r"\b(unittest|pytest|tox|nox|go test|cargo test|(npm|yarn|pnpm)( run)? test|jest|vitest|"
                        r"mocha|rspec|rake test|mvn( -\S+)* (test|verify)|gradlew? test|ctest|make (test|tests))\b")),
    ("lint", re.compile(r"\b(go vet|golangci-lint|staticcheck|ruff|flake8|pylint|mypy|pyright|black --check|eslint|"
                        r"prettier --check|tsc --noEmit|cargo clippy|cargo fmt --check|gofmt -l|shellcheck|rubocop|"
                        r"(make|npm run|yarn|pnpm) (lint|check|typecheck|vet))\b")),
    ("build", re.compile(r"\b(go build|cargo build|(npm|yarn|pnpm)( run)? build|mvn( -\S+)* package|"
                         r"gradlew? (build|assemble)|make build)\b")),
]


def ci_kind(cmd):
    """test / lint / build for a CI step worth running locally, else None."""
    if CI_SKIP.search(cmd):
        return None
    return next((kind for kind, rx in CI_KINDS if rx.search(cmd)), None)


def ci_run_lines(text):
    """Shell lines of the `run:` steps in a CI workflow, including `run: |` blocks.

    Inside a block, a bare `cd <dir>` line is carried into the lines after it."""
    out, lines, i = [], text.splitlines(), 0
    while i < len(lines):
        m = re.match(r"^(\s*)(?:-\s+)?run:\s*(.*?)\s*$", lines[i])
        i += 1
        if not m:
            continue
        value = m.group(2)
        if not re.fullmatch(r"[|>][-+]?", value):
            if value and not value.startswith("#"):
                out.append(value.strip("\"'"))
            continue
        indent, cd, buf = len(m.group(1)), "", ""
        while i < len(lines) and (not lines[i].strip() or len(lines[i]) - len(lines[i].lstrip()) > indent):
            line = lines[i].strip()
            i += 1
            if not line or line.startswith("#"):
                continue
            if line.endswith("\\"):  # shell line continuation
                buf += line[:-1].strip() + " "
                continue
            line, buf = buf + line, ""
            step = re.fullmatch(r"cd\s+(\S+)", line)
            if step:
                cd = f"cd {step.group(1)} && "
            else:
                out.append(cd + line)
    return out


def detect_commands(files):
    cands = []  # (cmd, kind, source)
    if "Makefile" in files:
        for m in re.finditer(r"^([A-Za-z0-9_\-]+):", (ROOT / "Makefile").read_text(), re.M):
            t = m.group(1)
            kind = {"test": "test", "tests": "test", "lint": "lint", "check": "lint", "vet": "lint",
                    "typecheck": "lint", "build": "build", "fmt": "format", "format": "format"}.get(t)
            if kind:
                cands.append((f"make {t}", kind, "Makefile"))
    if "package.json" in files:
        pj = load_json(ROOT / "package.json", {}) or {}
        runner = "pnpm" if "pnpm-lock.yaml" in files else "yarn" if "yarn.lock" in files else "npm run"
        for s in ("lint", "typecheck", "build", "test"):
            if s in pj.get("scripts", {}):
                cmd = f"{runner} {s}" if runner != "npm run" or s != "test" else "npm test"
                cands.append((cmd, "test" if s == "test" else "build" if s == "build" else "lint", "package.json"))
    for gm in sorted(f for f in files if f == "go.mod" or f.endswith("/go.mod")):
        cd = f"cd {gm[:-len('/go.mod')]} && " if "/" in gm else ""
        cands += [(cd + "go vet ./...", "lint", gm), (cd + "go build ./...", "build", gm),
                  (cd + "go test ./...", "test", gm)]
    if "Cargo.toml" in files:
        cands += [("cargo build", "build", "Cargo.toml"), ("cargo test", "test", "Cargo.toml")]
    py_meta = " ".join((ROOT / f).read_text(errors="ignore") for f in
                       ("pyproject.toml", "requirements.txt", "setup.cfg") if f in files)
    if "pytest" in py_meta:
        cands.append(("python3 -m pytest -q", "test", "pyproject/requirements"))
    ci_runs = []
    for f in sorted(files):
        if f.startswith(".github/workflows/") and f.endswith((".yml", ".yaml")) or f == ".gitlab-ci.yml":
            ci_runs += ci_run_lines((ROOT / f).read_text(errors="ignore"))
    for run in ci_runs:  # CI steps that check the code are candidates too; installs and deploys are not
        kind = ci_kind(run)
        if kind:
            cands.append((run, kind, "ci"))
    seen, result = set(), []
    for cmd, kind, src in cands:
        if cmd in seen:
            continue
        seen.add(cmd)
        result.append({"cmd": cmd, "kind": kind, "source": src, "in_ci": cmd in ci_runs, "verified": None})
    order = {k: i for i, k in enumerate(CMD_KINDS)}
    return sorted(result, key=lambda c: (not c["in_ci"], order.get(c["kind"], 9))), ci_runs


CMD_KINDS = ("format", "lint", "build", "test")


def merge_commands(detected, previous, ci_runs):
    """Detected commands plus the agent's `source: manual` ones, keeping earlier verification results.

    A manual command with `replaces: <cmd>` is a fixed invocation: the detected one it names is dropped."""
    manual = [c for c in previous if c.get("source") == "manual" and c.get("cmd")]
    replaced = {c.get("replaces") for c in manual}
    old = {c["cmd"]: c for c in previous if c.get("cmd")}
    out = [c for c in detected if c["cmd"] not in replaced]
    for c in out:  # a plain re-index keeps earlier verification results
        o = old.get(c["cmd"])
        if o and o.get("verified") is not None:
            c.update({k: o[k] for k in ("verified", "exit", "seconds", "tail") if k in o})
    have = {c["cmd"] for c in out}
    for c in manual:
        if c["cmd"] not in have:
            out.append({**c, "in_ci": c["cmd"] in ci_runs})
    order = {k: i for i, k in enumerate(CMD_KINDS)}
    return sorted(out, key=lambda c: (not c["in_ci"], order.get(c["kind"], 9)))


def verify_command(c):
    t0 = time.time()
    code, out, err = sh(c["cmd"], timeout=600)
    c.update(verified=code == 0, exit=code, seconds=round(time.time() - t0, 1))
    c.pop("tail", None)
    if code != 0:
        c["tail"] = (out + err).strip().splitlines()[-5:]


def cmd_add_command(args):
    """Record a command the agent added or fixed, so re-index keeps it."""
    rest = [a for i, a in enumerate(args) if a not in ("--replaces", "--no-verify")
            and (i == 0 or args[i - 1] != "--replaces")]
    if len(rest) < 2 or rest[0] not in CMD_KINDS:
        sys.exit(f"ctxh add-command {'|'.join(CMD_KINDS)} \"<cmd>\" [--replaces \"<detected cmd>\"] [--no-verify]")
    if not opted_in():
        sys.exit(render_prompt("this repo has no .ctx/ yet: run the ctx-harness build skill ({{command:build}})"))
    data = load_json(COMMANDS, {}) or {}
    ci_runs = data.get("ci_runs", [])
    entry = {"cmd": " ".join(rest[1:]), "kind": rest[0], "source": "manual", "verified": None}
    replaces = opt(args, "--replaces")
    if replaces:
        entry["replaces"] = replaces
    entry["in_ci"] = entry["cmd"] in ci_runs
    if "--no-verify" not in args:
        verify_command(entry)
    others = [c for c in data.get("commands", []) if c.get("cmd") not in (entry["cmd"], replaces)]
    data["commands"] = merge_commands([c for c in others if c.get("source") != "manual"], others + [entry], ci_runs)
    write_json(COMMANDS, data)
    state = {True: "verified", False: f"failed (exit {entry.get('exit')})", None: "not verified"}[entry["verified"]]
    print(f"added manual {entry['kind']} command: {entry['cmd']} ({state})"
          + (f"; replaces {replaces}" if replaces else ""))


def cmd_build_index(args):
    t0 = time.time()
    files = list_files()
    fileset = set(files)
    go_module = {}  # module path -> directory prefix ("" for repo root); supports nested go.mod
    for gm in [f for f in files if f == "go.mod" or f.endswith("/go.mod")]:
        m = re.search(r"^module\s+(\S+)", (ROOT / gm).read_text(errors="ignore"), re.M)
        if m:
            go_module[m.group(1)] = gm[:-len("go.mod")]
    roots = package_roots(files)
    lang_by_file = {f: lang for f in files if (lang := lang_of(f))}
    stem_index = defaultdict(list)
    for f in lang_by_file:
        parts = (f.rsplit(".", 1)[0] if Path(f).suffix else f).lower().split("/")
        for i in range(len(parts)):
            stem_index["/".join(parts[i:])].append(f)

    nodes, langs, entry, manifests, parsers = {}, Counter(), [], [], {}
    for f in files:
        name = f.rsplit("/", 1)[-1]
        if name in MANIFESTS or f.startswith(".github/workflows/"):
            if f.count("/") <= 3:
                manifests.append(f)
        lang = lang_by_file.get(f)
        doc = None if lang else DOC_LANGS.get(Path(f).suffix.lower())
        if not lang and not doc:
            continue
        try:
            text = (ROOT / f).read_text(errors="ignore")
        except OSError:
            continue
        if doc:  # prompts and docs: findable by heading and part of co-change, never code
            body = re.sub(r"^(```|~~~).*?^\1", lambda m: "\n" * m.group(0).count("\n"), text,
                          flags=re.M | re.S)  # "# comment" in a fence is no heading; keep line numbers
            heads = [[m.group(1), body.count("\n", 0, m.start()) + 1] for m in HEADING_RX.finditer(body)]
            nodes[f] = {"lang": doc, "role": "docs", "module": module_of(f, roots), "lines": text.count("\n") + 1,
                        "sha": hashlib.sha1(text.encode()).hexdigest()[:12], "imports": [], "symbols": heads[:200]}
            continue
        role = role_of(f, text[:400])
        langs[lang] += 1
        if name in ENTRY_NAMES or "__name__ == \"__main__\"" in text or "__name__ == '__main__'" in text \
                or not Path(f).suffix:  # extensionless shebang scripts are run directly
            if role == "src":
                entry.append(f)
        parsed = ts_extract(lang, f, text)
        if parsed:
            parsers[lang] = "tree-sitter"
            specs, symbols = parsed
        else:
            parsers.setdefault(lang, "regex")
            specs = [spec for rx in IMPORT_RX.get(lang, []) for spec in rx.findall(text)]
            symbols = []
            rx = SYMBOL_RX.get(lang)
            if rx:
                for m in rx.finditer(text):
                    symbols.append([m.group(m.lastindex), text.count("\n", 0, m.start()) + 1])
        imports = []
        for spec in specs:
            for target in resolve_import(lang, spec, f, fileset, stem_index, go_module):
                if target != f and target not in imports:
                    imports.append(target)
        nodes[f] = {"lang": lang, "role": role, "module": module_of(f, roots), "lines": text.count("\n") + 1,
                    "sha": hashlib.sha1(text.encode()).hexdigest()[:12], "imports": imports,
                    "symbols": symbols[:200]}

    for n in nodes.values():  # empty package markers etc. are not worth ranking or describing
        if n["role"] == "src" and not n["symbols"] and n["lines"] <= 3:
            n["role"] = "trivial"
    src = [f for f, n in nodes.items() if n["role"] == "src"]
    edges = [(f, t) for f in src for t in nodes[f]["imports"] if t in nodes and nodes[t]["role"] == "src"]
    rank = pagerank(src, edges)
    for f in src:
        nodes[f]["rank"] = round(rank[f], 4)

    hist, commits = mine_git(set(nodes))
    for f, h in hist.items():
        nodes[f].update(h)

    modules = defaultdict(lambda: {"files": 0, "rank": 0.0, "deps": set(), "rdeps": set(), "tests": set()})
    for f, n in nodes.items():
        m = modules[n["module"]]
        m["files"] += 1
        m["rank"] += n.get("rank", 0)
        for t in n["imports"]:
            tm = nodes[t]["module"]
            if n["role"] == "test":
                modules[tm]["tests"].add(f)
            elif tm != n["module"]:
                m["deps"].add(tm)
                modules[tm]["rdeps"].add(n["module"])
    mods = {k: {"files": v["files"], "rank": round(v["rank"], 4), "deps": sorted(v["deps"]),
                "rdeps": sorted(v["rdeps"]), "tests": sorted(v["tests"])} for k, v in modules.items()}

    commands, ci_runs = detect_commands(fileset)
    commands = merge_commands(commands, (load_json(COMMANDS, {}) or {}).get("commands", []), ci_runs)
    if "--verify" in args:
        for c in commands:
            if c["kind"] != "format":
                verify_command(c)
    _, head, _ = sh(["git", "rev-parse", "--short", "HEAD"])
    graph = {"version": 1, "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S"), "head": head.strip(),
             "commits_mined": commits, "package_roots": roots,
             "stack": {"languages": dict(langs.most_common()), "manifests": sorted(manifests),
                       "entrypoints": sorted(entry), "parsers": dict(sorted(parsers.items()))},
             "files": nodes, "modules": mods}
    write_json(GRAPH, graph)
    write_json(COMMANDS, {"commands": commands, "ci_runs": ci_runs})
    if not (CTX / ".gitignore").exists():
        (CTX / ".gitignore").write_text(CTX_GITIGNORE)
    if "--release-lock" in args:
        (TMP / "index.lock").unlink(missing_ok=True)
    if "--quiet" in args:
        return
    ver = [c for c in commands if c.get("verified")]
    docs = sum(1 for n in nodes.values() if n["role"] == "docs")
    print(f"indexed {len(nodes) - docs} code files and {docs} docs in {len(mods)} modules, {len(edges)} internal imports, "
          f"{commits} commits mined, {len(commands)} commands ({len(ver)} verified) "
          f"in {time.time() - t0:.1f}s -> .ctx/graph.json, .ctx/commands.json")
    for problem in card_module_problems(graph):
        print(f"warning: {problem}")


# ---------------------------------------------------------------- skeleton
MAP_DEPS = 4  # dependencies named per module in the map; `ctxh q module` has the rest
MAP_COCHANGE_MIN = 3  # two shared commits is coincidence as often as coupling; `ctxh q cochange` still lists them


def key_file_order(node):
    """Sort key for a module's key files. Rank is per package in Go, so every file of one ties on it;
    break the tie by fix history, then churn, then size of the API."""
    return (-node.get("rank", 0), -len(node.get("risk", [])), -node.get("churn", 0), -len(node.get("symbols", [])))


def cmd_skeleton(_):
    g = need_graph()
    cmds = (load_json(COMMANDS, {}) or {}).get("commands", [])
    files, mods = g["files"], g["modules"]
    src_mods = sorted([m for m in mods if any(f["module"] == m and f["role"] == "src" for f in files.values())],
                      key=lambda m: -mods[m]["rank"])
    out = [f"# Repo map  <!-- generated @ {g['head']}; keep under {BUDGET['map_lines']} lines -->", ""]
    langs = ", ".join(f"{k} ({v})" for k, v in g["stack"]["languages"].items())
    out.append(f"Stack: {langs}. Manifests: {', '.join(g['stack']['manifests']) or 'none'}.")
    if g["stack"]["entrypoints"]:
        out.append(f"Entry points: {', '.join(g['stack']['entrypoints'])}.")
    good = [c["cmd"] for c in cmds if c.get("verified")]
    unverified = [c["cmd"] for c in cmds if c.get("verified") is None and c["kind"] != "format"]
    if good:
        out.append("Verified commands: " + " · ".join(f"`{c}`" for c in good) + ".")
    elif unverified:
        out.append("Commands (not verified yet): " + " · ".join(f"`{c}`" for c in unverified) + ".")
    out += ["", "## Modules (most central first)", "", "| module | purpose | key files | depends on |",
            "|---|---|---|---|"]
    for m in src_mods[:12]:
        key = sorted([f for f, n in files.items() if n["module"] == m and n["role"] == "src"],
                     key=lambda f: (key_file_order(files[f]), f))[:3]
        key = ", ".join(k.rsplit("/", 1)[-1] for k in key)
        deps = sorted(mods[m]["deps"], key=lambda d: (-mods.get(d, {}).get("rank", 0), d))
        shown = ", ".join(deps[:MAP_DEPS]) + (f" +{len(deps) - MAP_DEPS} more" if len(deps) > MAP_DEPS else "")
        out.append(f"| {m} | TODO(llm) | {key} | {shown or '-'} |")
    coupling = []
    for f, n in files.items():
        for other, c in n.get("cochange", []):
            o = files.get(other, {})
            if c >= MAP_COCHANGE_MIN and f < other and o.get("module") != n["module"] and n["role"] == o.get("role") == "src":
                linked = other in n["imports"] or f in o.get("imports", [])
                coupling.append((c, f, other, "" if linked else ", no import link"))
    if coupling:
        out += ["", "## Change together (from git history)"]
        for c, a, b, note in sorted(coupling, reverse=True)[:5]:
            out.append(f"- {a} <-> {b} ({c} commits{note})")
    risky = sorted([(len(n.get("risk", [])), f) for f, n in files.items() if n.get("risk")], reverse=True)[:4]
    if risky:
        out += ["", "## Fragile files (fix/revert history)"]
        for _, f in risky:
            out.append(f"- {f}: {files[f]['risk'][0]}")
    out += ["", "## Finding things",
            "- Ask the index first: `ctxh q find|rdeps|impact|cochange|tests|owner|module <arg>`",
            "- Module cards: `.ctx/cards/<module-with-dashes>.md` (open only for the module you touch)",
            "- Gotchas learned from past tasks: `.ctx/learned.md`"]
    (CTX / "map.draft.md").write_text("\n".join(out) + "\n")
    CARDS.mkdir(parents=True, exist_ok=True)
    if not LEARNED.exists():
        LEARNED.write_text("# Learned from past tasks\n"
                           "<!-- Curator-owned. One factual line per entry, each with its evidence. -->\n")
    print(f"wrote .ctx/map.draft.md ({len(out)} lines). Fill TODO(llm) cells, then save as .ctx/map.md")


# ---------------------------------------------------------------- keyword search (BM25 over names and comments)
STOPWORDS = set("a an and are as at be by for from how in is it of on or that the this to was what when where which "
                "who why with does do handled handle we our".split())
COMMENT_RX = re.compile(r'^\s*(?:#(?!!)|//|/\*+|\*(?!/)|--|"""|\'\'\'|<!--)\s?(.*)$')


def terms(text):
    """Lowercased, identifier-split, lightly stemmed words: 'chargeOnce' -> ['charge', 'once']."""
    out = []
    for w in re.findall(r"[A-Za-z][a-z]+|[A-Z]+(?![a-z])|\d+", re.sub(r"[_\-]", " ", text)):
        w = w.lower()
        if len(w) < 2 or w in STOPWORDS:
            continue
        for suffix in ("ies", "ing", "ed", "es", "s"):
            if w.endswith(suffix) and len(w) - len(suffix) >= 3:
                w = w[:-len(suffix)] + ("y" if suffix == "ies" else "")
                break
        if w.endswith("e") and len(w) > 4:  # charge / charging / charged -> charg
            w = w[:-1]
        out.append(w)
    return out


def search_units(files):
    """(path, line, label, terms) to rank: each symbol with its nearby comments, loose comment blocks, doc sections."""
    units = []
    for f, n in files.items():
        try:
            lines = (ROOT / f).read_text(errors="ignore").splitlines()
        except OSError:
            continue
        comment = [m.group(1) if (m := COMMENT_RX.match(l)) else None for l in lines]
        if n["role"] == "docs":
            heads = n["symbols"] or [["", 1]]
            for i, (name, line) in enumerate(heads):
                end = heads[i + 1][1] - 1 if i + 1 < len(heads) else len(lines)
                units.append((f, line, name, terms(name) * 3 + terms(" ".join(lines[line:min(end, line + 15)]))))
            continue
        used = set()
        for name, line in n["symbols"]:
            i, above = line - 2, []
            while i >= 0 and comment[i] is not None and len(above) < 8:
                above.append(comment[i])
                used.add(i)
                i -= 1
            below = []
            for j in range(line, min(line + 8, len(lines))):
                text = comment[j] if comment[j] is not None else (
                    lines[j].strip().strip("\"'") if re.match(r'\s*[rbu]?("""|\'\'\')', lines[j]) else None)
                if text is not None:
                    below.append(text)
                    used.add(j)
            units.append((f, line, name, terms(name) * 3 + terms(" ".join(above + below))))
        block = []
        for i, c in enumerate(comment + [None]):
            if c is not None and i not in used:
                block.append((i, c))
                continue
            if len(block) >= 3:
                units.append((f, block[0][0] + 1, "comment", terms(" ".join(t for _, t in block))))
            block = []
    return units


def keyword_search(g, query, limit=8):
    """BM25 ranking of search_units for the query terms: [(score, path, line, label)]."""
    want = terms(query)
    if not want:
        return []
    units = [u for u in search_units(g["files"]) if u[3]]
    if not units:
        return []
    df = Counter(t for u in units for t in set(u[3]))
    avg = sum(len(u[3]) for u in units) / len(units)
    k1, b, N = 1.2, 0.75, len(units)
    scored = []
    for f, line, label, ts in units:
        tf = Counter(ts)
        score, hit = 0.0, 0
        for t in set(want):
            if tf[t]:
                hit += 1
                idf = math.log(1 + (N - df[t] + 0.5) / (df[t] + 0.5))
                score += idf * tf[t] * (k1 + 1) / (tf[t] + k1 * (1 - b + b * len(ts) / avg))
        score *= hit / len(set(want))  # a unit that covers every query word beats one repeating a single word
        if score > 0:
            scored.append((round(score, 2), f, line, label))
    role = lambda f: {"src": 0, "docs": 1}.get(g["files"][f]["role"], 2)
    scored.sort(key=lambda x: (-x[0], role(x[1]), x[1], x[2]))
    return scored[:limit]


# ---------------------------------------------------------------- queries
def cmd_q(args):
    if not args:
        sys.exit("usage: ctxh q find|search|deps|rdeps|impact|cochange|tests|owner|risk|module|hot [arg]")
    g = need_graph()
    files, q, arg = g["files"], args[0], args[1] if len(args) > 1 else None
    if q == "hot":
        n = int(arg or 8)
        for f in sorted([f for f in files if "rank" in files[f]], key=lambda f: -files[f]["rank"])[:n]:
            print(f"{files[f]['rank']:.3f}  {f}")
        return
    if q == "find":
        if not arg:
            sys.exit("ctxh q find <symbol>")
        exact, fuzzy = [], []
        for f, n in files.items():
            for name, line in n["symbols"]:
                if name == arg:
                    exact.append(f"{f}:{line}")
                elif arg.lower() in name.lower():
                    fuzzy.append(f"{f}:{line}  {name}")
        hits = exact or fuzzy
        if hits:
            print("\n".join(hits[:12]))
            return
        found = keyword_search(g, " ".join(args[1:]))
        if found:  # a concept, not a name: answer from comments and docstrings rather than nothing
            print(f"keyword matches for '{' '.join(args[1:])}' (not a symbol name):")
            print("\n".join(f"{f}:{line}  {label}  ({score})" for score, f, line, label in found))
        else:
            print(f"no symbol matching '{arg}' (try grep)")
        return
    if q == "search":
        if not arg:
            sys.exit("ctxh q search <words...>")
        found = keyword_search(g, " ".join(args[1:]))
        print("\n".join(f"{f}:{line}  {label}  ({score})" for score, f, line, label in found)
              or f"no keyword matches for '{' '.join(args[1:])}' (try grep)")
        return
    if q == "module":
        m = module_of(arg, g.get("package_roots", [])) if arg not in g["modules"] else arg
        if m not in g["modules"]:
            m = files[resolve_arg(g, arg)]["module"]
        info = g["modules"][m]
        card = CARDS / (m.replace("/", "-") + ".md")
        print(f"module {m}: {info['files']} files, depends on {info['deps'] or '-'}, used by {info['rdeps'] or '-'}")
        print(f"tests: {', '.join(info['tests']) or 'none found'}")
        print(f"card: {card.relative_to(ROOT) if card.exists() else 'none yet'}")
        return
    f = resolve_arg(g, arg) if arg else sys.exit(f"ctxh q {q} <file>")
    n = files[f]
    if q == "deps":
        print("\n".join(n["imports"]) or "no internal imports")
    elif q == "rdeps":
        r = [o for o, on in files.items() if f in on["imports"]]
        print("\n".join(sorted(r)) or "nothing imports this file")
    elif q == "impact":
        seen, frontier = {}, [f]
        for depth in (1, 2, 3):
            nxt = []
            for cur in frontier:
                for o, on in files.items():
                    if cur in on["imports"] and o not in seen and o != f:
                        seen[o] = depth
                        nxt.append(o)
            frontier = nxt
        for o, d in sorted(seen.items(), key=lambda x: (x[1], x[0])):
            print(f"{d}  {o}{'  (test)' if files[o]['role'] == 'test' else ''}")
        if not seen:
            print("no dependents")
    elif q == "cochange":
        co = n.get("cochange", [])
        print("\n".join(f"{c}x  {o}" for o, c in co) or "no recurring co-changes in git history")
    elif q == "tests":
        direct = [o for o, on in files.items() if on["role"] == "test" and f in on["imports"]]
        if not direct:
            ups = {o for o, on in files.items() if f in on["imports"]}
            direct = [o for o, on in files.items() if on["role"] == "test" and ups & set(on["imports"])]
        print("\n".join(sorted(direct)) or "no tests import this file (or its direct dependents)")
    elif q == "owner":
        print(", ".join(f"{a} ({int(s * 100)}%)" for a, s in n.get("owners", [])) or "no git history")
    elif q == "risk":
        print("\n".join(n.get("risk", [])) or "no fix/revert commits touch this file")
    else:
        sys.exit(f"unknown query '{q}'")


# ---------------------------------------------------------------- cards
def parse_card(text):
    meta, anchors, body = {}, {}, text
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if m:
        head, body = m.group(1), m.group(2)
        in_anchors = False
        for line in head.splitlines():
            if re.match(r"^anchors:\s*$", line):
                in_anchors = True
            elif in_anchors and line.startswith((" ", "\t", "-")):
                # accept "  path: hash", "  - path", "  path: path" and "  - path: hash"
                item = line.strip().lstrip("-").strip()
                k, _, v = item.partition(":")
                k, v = k.strip().strip("'\""), v.strip().strip("'\"")
                if k in ("path", "file") and v:
                    k, v = v, ""
                if k:
                    anchors[k] = v
            else:
                in_anchors = False
                k, _, v = line.partition(":")
                meta[k.strip()] = v.strip()
    return meta, anchors, body


def render_card(meta, anchors, body):
    head = [f"{k}: {v}" for k, v in meta.items()] + ["anchors:"] + [f"  {k}: {v}" for k, v in anchors.items()]
    return "---\n" + "\n".join(head) + "\n---\n" + body.lstrip("\n")


def cmd_anchor(args):
    if not args:
        sys.exit("ctxh anchor <card.md>")
    card = Path(args[0])
    meta, anchors, body = parse_card(card.read_text())
    if not any((ROOT / a).is_file() for a in anchors) and meta.get("module"):
        g = need_graph()
        anchors = {f: "" for f, n in g["files"].items() if n["module"] == meta["module"] and n["role"] == "src"}
    missing = [a for a in anchors if not (ROOT / a).exists()]
    anchors = {a: file_sha(ROOT / a) for a in anchors if (ROOT / a).exists()}
    meta["updated"] = time.strftime("%Y-%m-%d")
    card.write_text(render_card(meta, anchors, body))
    print(f"anchored {card.name} to {len(anchors)} files" + (f"; dropped missing: {missing}" if missing else ""))


def cmd_card_draft(args):
    """Write .ctx/cards/<module>.md with everything the index knows; the writer only adds invariants."""
    if not args:
        sys.exit("ctxh card-draft <module>")
    g = need_graph()
    mod = args[0].strip("/")
    if mod not in g["modules"]:
        sys.exit(f"module '{mod}' is not in the index (see `ctxh q hot`)")
    card = CARDS / (mod.replace("/", "-") + ".md")
    if card.exists():
        sys.exit(f"{card.relative_to(ROOT)} exists: refresh it in place instead")
    files = g["files"]
    mine = sorted((f for f, n in files.items() if n["module"] == mod and n["role"] == "src"),
                  key=lambda f: (key_file_order(files[f]), f))
    body = ["TODO(llm) one line on what the module owns.", "", "## Invariants",
            "- TODO(llm) rules that hold in code, each naming the symbol that enforces it (read only the top files:"
            f" {', '.join(f.rsplit('/', 1)[-1] for f in mine[:3])}).", ""]
    seen, hist = set(), []
    for f in mine:  # one commit touching several files is one line
        for r in files[f].get("risk", []):
            if r not in seen and len(hist) < 6:
                seen.add(r)
                hist.append(f"- `{f}`: {r}")
    coupled = []
    for f in mine:
        for other, c in files[f].get("cochange", []):
            if files.get(other, {}).get("module") != mod and files.get(other, {}).get("role") == "src":
                coupled.append((c, f, other))
    if coupled:
        hist.append("- Changes together with: " + ", ".join(
            f"`{o}` ({c} commits, via `{f.rsplit('/', 1)[-1]}`)" for c, f, o in sorted(coupled, reverse=True)[:3]))
    if hist:
        body += ["## History", *hist, ""]
    tests = g["modules"][mod]["tests"]
    if tests:
        body += ["## Tests", ", ".join(f"`{t}`" for t in tests)]
    CARDS.mkdir(parents=True, exist_ok=True)
    card.write_text(render_card({"module": mod}, {f: "" for f in mine}, "\n".join(body).rstrip() + "\n"))
    cmd_anchor([str(card)])
    print(f"drafted {card.relative_to(ROOT)}: fill the TODO(llm) lines, drop History lines that are noise, "
          "then run `ctxh check`")


def card_module_problems(g):
    """Cards whose `module:` names no module in the index: their "new files" staleness can never fire."""
    out = []
    for card in sorted(CARDS.glob("*.md")) if CARDS.exists() and g else []:
        mod = parse_card(card.read_text())[0].get("module")
        if mod and mod not in g["modules"]:
            near = sorted(m for m in g["modules"] if m.startswith(mod + "/") or mod.startswith(m + "/"))
            out.append(f"{card.name}: module '{mod}' is not in the index"
                       + (f" (nearest: {', '.join(near[:3])})" if near else "; see `ctxh q module <file>`"))
    return out


def index_lag(g):
    """Code files committed since the index was built (None if unknown)."""
    if not g or not g.get("head"):
        return None
    code, out, _ = sh(["git", "diff", "--name-only", g["head"], "HEAD"])
    if code != 0:
        return None
    rules = ignore_rules()
    return [f for f in out.splitlines()
            if not f.startswith((".ctx/", ".claude/")) and not ignored(f, rules)
            and (f in g.get("files", {}) or lang_of(f))]  # deleted files count if they were indexed


def stale_report(include_index=True):
    lines = []
    g = load_json(GRAPH)
    if include_index:
        if g is None and opted_in():
            lines.append("no index yet (run `ctxh build-index`, it is cheap)")
        lag = index_lag(g)
        if lag:
            lines.append(f"index predates changes to {len(lag)} code files (run `ctxh build-index`, it is cheap)")
    for card in sorted(CARDS.glob("*.md")) if CARDS.exists() else []:
        meta, anchors, _ = parse_card(card.read_text())
        changed = [a for a, s in anchors.items() if file_sha(ROOT / a) != s]
        new = []
        if g and meta.get("module"):
            new = [f for f, n in g["files"].items()
                   if n["module"] == meta["module"] and n["role"] == "src" and f not in anchors]
        if changed or new:
            why = []
            if changed:
                why.append("changed: " + ", ".join(a.rsplit("/", 1)[-1] for a in changed))
            if new:
                why.append("new files: " + ", ".join(a.rsplit("/", 1)[-1] for a in new))
            lines.append(f"stale card {card.name} ({'; '.join(why)})")
    return lines


def cmd_stale(_):
    print("\n".join(stale_report()) or "everything fresh")


def cmd_check(_):
    problems = []

    def dead_paths(name, text):
        for p in set(re.findall(r"`([\w\-./]+/[\w\-.]+\.\w+)`", text)):
            if not (ROOT / p).exists():
                problems.append(f"{name}: references missing path {p}")

    def phrasing(name, text):
        for m in IMPERATIVE.finditer(text):
            problems.append(f"{name}: instruction-like phrase '{m.group(0)}' (state facts, not orders)")
        if "TODO(llm)" in text:
            problems.append(f"{name}: unfilled TODO(llm)")

    if MAP.exists():
        t = MAP.read_text()
        if t.count("\n") > BUDGET["map_lines"] or len(t) > BUDGET["map_bytes"]:
            problems.append(f"map.md over budget ({t.count(chr(10))} lines, {len(t)} bytes)")
        dead_paths("map.md", t)
        phrasing("map.md", t)
    else:
        problems.append("no .ctx/map.md")
    for card in sorted(CARDS.glob("*.md")) if CARDS.exists() else []:
        t = card.read_text()
        _, anchors, body = parse_card(t)
        if body.count("\n") > BUDGET["card_lines"]:
            problems.append(f"{card.name} over budget ({body.count(chr(10))} lines)")
        if not anchors:
            problems.append(f"{card.name}: no anchors (run ctxh anchor)")
        elif not all(re.fullmatch(r"[0-9a-f]{12}", v) for v in anchors.values()):
            problems.append(f"{card.name}: anchors not stamped (run ctxh anchor {card.relative_to(ROOT)})")
        dead_paths(card.name, body)
        phrasing(card.name, body)
    g = load_json(GRAPH)
    problems += card_module_problems(g) if g else []
    if LEARNED.exists() and LEARNED.read_text().count("\n") > BUDGET["learned_lines"]:
        problems.append("learned.md over budget: consolidate or prune")
    print("\n".join(problems) or "ok: budgets respected, no dead paths")
    sys.exit(1 if problems else 0)


# ---------------------------------------------------------------- readiness
FIXTURE_DIRS = {"demo", "demos", "fixture", "fixtures", "testdata", "example", "examples", "sample", "samples",
                "vendor", "third_party", "thirdparty"}
SMALL_REPO_FILES = 15  # below this, two `cat`s load the whole repo: cards and probes cost more than they save


def card_candidates(g, limit=5):
    """The most central modules with 3+ source files, and those among them that have no card yet."""
    src = Counter(n["module"] for n in g["files"].values() if n["role"] == "src")
    have = {parse_card(c.read_text())[0].get("module") for c in CARDS.glob("*.md")} if CARDS.exists() else set()
    ranked = sorted((m for m in src if src[m] >= 3), key=lambda m: -g["modules"][m]["rank"])[:limit]
    return [m for m in ranked if m not in have], ranked


def fixture_share(g):
    """(directory, share of source files) of the biggest fixture-looking directory, if any."""
    src = [f for f, n in g["files"].items() if n["role"] == "src"]
    dirs = Counter()
    for f in src:
        parts = f.split("/")[:-1]
        for i, part in enumerate(parts):
            if part.lower() in FIXTURE_DIRS:
                dirs["/".join(parts[:i + 1])] += 1
                break
    if not dirs or not src:
        return None
    d, c = dirs.most_common(1)[0]
    return d, c, len(src)


def cmd_ready(_):
    """One verdict on whether this repo's context is usable: FAIL blocks, warn is worth a look, ok is fine."""
    if not opted_in():
        sys.exit(render_prompt("not ready: no .ctx/ yet. Run the build skill ({{command:build}})."))
    rows = []
    add = lambda level, text: rows.append((level, text))
    g = load_json(GRAPH)
    if not g:
        add("FAIL", "no index: run `ctxh build-index --verify`")
    else:
        lag = index_lag(g)
        if lag:
            add("warn", f"index predates changes to {len(lag)} code files: run `ctxh build-index`")
        else:
            add("ok", f"index current ({len(g['files'])} files, {len(g['modules'])} modules)")
    if not MAP.exists():
        add("FAIL", "no .ctx/map.md: fill .ctx/map.draft.md (`ctxh skeleton`) and save it as map.md")
    elif "TODO(llm)" in MAP.read_text():
        add("FAIL", "map.md still has TODO(llm) purpose cells")
    else:
        add("ok", f"map.md has {MAP.read_text().count(chr(10))} lines")
    if g:
        tests = [c for c in (load_json(COMMANDS, {}) or {}).get("commands", []) if c["kind"] == "test"]
        if any(c.get("verified") for c in tests):
            add("ok", "a test command is verified")
        elif tests:
            add("warn", "test commands detected but none verified: `ctxh build-index --verify`, or fix one with "
                        "`ctxh add-command`")
        else:
            add("warn", "no test command detected: agents will guess how to run tests "
                        "(`ctxh add-command test \"<cmd>\"`)")
        fx = fixture_share(g)
        if fx and fx[1] * 3 >= fx[2]:
            add("warn", f"{fx[1]} of {fx[2]} source files are under '{fx[0]}/', which looks like fixtures: add a "
                        "`.ctxignore` so the map and `q hot` describe the real code")
        missing, ranked = card_candidates(g)
        n_src = sum(1 for n in g["files"].values() if n["role"] == "src")
        if n_src < SMALL_REPO_FILES:
            add("ok", f"small repo ({n_src} source files): no cards needed, the map is enough")
        elif not ranked:
            add("ok", "no module has 3+ source files: no cards needed")
        elif missing:
            add("warn", f"central modules without a card: {', '.join(missing)} (one card-writer call each)")
        else:
            add("ok", f"cards cover the {len(ranked)} most central modules")
    stale = stale_report(include_index=False)
    add("warn" if stale else "ok", f"{len(stale)} stale cards: run the curate skill" if stale else "no stale cards")
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        try:
            cmd_check([])
            failed = False
        except SystemExit as e:
            failed = bool(e.code)
    if failed:
        add("FAIL", "`ctxh check`: " + "; ".join(buf.getvalue().strip().splitlines())[:300])
    else:
        add("ok", "`ctxh check` passes")
    if ADAPTER.NAME == "claude":
        st = ROOT / ".claude" / "settings.json"
        if not st.exists() or "ctxh" not in st.read_text():
            add("warn", "`Bash(ctxh *)` is not allowed in .claude/settings.json: agents get a prompt on every query")
    code, tracked, _ = sh(["git", "ls-files", ".ctx"])
    if code == 0 and not tracked.strip():
        add("warn", ".ctx/ is not committed: teammates and CI start without context")
    for level, text in rows:
        print(f"{level:>4}  {text}")
    fails = sum(1 for level, _ in rows if level == "FAIL")
    warns = sum(1 for level, _ in rows if level == "warn")
    print(("not ready" if fails else "ready") + f": {fails} blocking, {warns} warnings")
    sys.exit(1 if fails else 0)


# ---------------------------------------------------------------- transcripts, traces, metrics
def parse_transcript(path: Path):
    """Tokens, steps, files and commands of one session, from the adapter's normalized trace."""
    trace = ADAPTER.read_session(path)
    if trace is None:
        return None
    usage_keys = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
    tok = {"main": Counter(), "sub": Counter()}
    for u in trace["usage"]:
        for k in usage_keys:
            tok[u["side"]][k] += u.get(k) or 0
    main = [c for c in trace["calls"] if c["side"] == "main"]
    reads, edits, cmds, failed, ctx_q, misses, agents = [], [], [], [], [], [], Counter()
    unknown = Counter()
    for call in main:
        kind, err, body = call["kind"], call["error"], call["output"]
        if kind is None:
            unknown[call["tool"] or "?"] += 1
        elif kind == "read":
            reads.append(call["path"])
        elif kind == "edit":
            edits.append(call["path"])
        elif kind == "shell":
            c = call["command"]
            cmds.append(c[:200])
            if re.search(r"(^|[\s/;&|(])ctxh?\s+q\s", c):
                ctx_q.append(c[:120])
                if re.search(r"no (symbol|indexed file|internal|keyword)|nothing imports|no tests", body):
                    misses.append(c[:120])
            if err:
                failed.append({"cmd": c[:200], "out": body[:200]})
        elif kind == "subagent":
            agents[call["agent"] or "general"] += 1
    rel = lambda p: os.path.relpath(p, ROOT) if p and os.path.isabs(p) else p

    def total(c):
        return sum(c[k] for k in usage_keys)

    return {
        "tokens_main": dict(tok["main"]), "tokens_sub": dict(tok["sub"]),
        "tokens_total": total(tok["main"]) + total(tok["sub"]),
        "tokens_uncached": sum(tok[s]["input_tokens"] + tok[s]["output_tokens"] + tok[s]["cache_creation_input_tokens"]
                               for s in tok),
        "steps": len(main),
        "files_read": sorted({rel(p) for p in reads}), "files_edited": sorted({rel(p) for p in edits}),
        "commands": cmds, "failed_commands": failed, "ctx_queries": ctx_q, "ctx_misses": misses,
        "subagents": dict(agents),
        "assistant_messages": trace["assistant_messages"], "usage_messages": len(trace["usage"]),
        "known_tool_calls": len(main) - sum(unknown.values()), "unknown_tools": [n for n, _ in unknown.most_common()],
        "tool_version": trace["tool_version"],
    }


def transcript_warning(data):
    """One sentence saying why a transcript parsed to nothing usable, else None.

    Everything measured here (tokens, traces, the review gate) is read out of the agent's session
    transcript. When that format moves, the honest failure is a warning, not a row of zeros.
    """
    if not data:
        return None
    where = f"transcript written by {ADAPTER.LABEL} {data['tool_version']}" if data["tool_version"] else "transcript"
    if not data["usage_messages"]:
        if not data["assistant_messages"]:
            return f"no assistant messages in this {where}: nothing to measure"
        return (f"{data['assistant_messages']} assistant messages but no `usage` in this {where}: the format "
                f"has likely changed, so token counts would all be zero (ctxh {VERSION})")
    if data["steps"] and not data["known_tool_calls"]:
        names = ", ".join(data["unknown_tools"][:5])
        return (f"none of the {data['steps']} tool calls in this {where} carry a name ctxh knows ({names}): "
                f"traces stay empty and the review gate cannot fire (ctxh {VERSION})")
    return None


def warn_once(kind, message):
    """Warn on stderr, at most once per state, so an automatic hook doesn't nag every session."""
    state = TMP / "warnings.json"
    seen = load_json(state, {}) or {}
    if seen.get(kind) == message:
        return False
    seen[kind] = message
    write_json(state, seen)
    print(f"ctx-harness: {message}", file=sys.stderr)
    return True


# ---------------------------------------------------------------- shared trace sink (opt-in, for team-wide curation)
SINK_TIMEOUT = 3  # seconds; the Stop hook never waits longer than this on the network
SINK_KEEP = 2000  # traces kept per repo in a Redis sink


def repo_id():
    """Stable name for this repo across machines: CTXH_TRACE_REPO, else the origin URL, else the folder name."""
    rid = env("TRACE_REPO")
    if not rid:
        code, url, _ = sh(["git", "remote", "get-url", "origin"])
        url = url.strip() if code == 0 else ""
        url = re.sub(r"^[a-z+]+://([^@/]*@)?", "", url)  # scheme and any credentials
        url = re.sub(r"^[^@/]*@", "", url).replace(":", "/")  # git@host:owner/repo
        rid = re.sub(r"\.git$", "", url) or ROOT.name
    return re.sub(r"[^\w.\-]+", "_", rid).strip("_")


def shared_trace(trace):
    """What leaves the machine: paths, commands and query strings, never command output (it can hold code)."""
    out = {k: v for k, v in trace.items() if k != "failed_commands"}
    out["failed_commands"] = [{"cmd": c["cmd"]} for c in trace.get("failed_commands", [])]
    out["repo"] = repo_id()
    return out


def redis_call(url, *cmd):
    """One command to a Redis server (redis://[:password@]host[:port][/db]) over a raw socket, RESP2."""
    import socket
    from urllib.parse import urlparse
    u = urlparse(url)
    with socket.create_connection((u.hostname or "localhost", u.port or 6379), timeout=SINK_TIMEOUT) as sock:
        f = sock.makefile("rb")

        def send(*words):
            parts = [str(w).encode() for w in words]
            sock.sendall(b"*%d\r\n" % len(parts) + b"".join(b"$%d\r\n%s\r\n" % (len(x), x) for x in parts))
            return read()

        def read():
            line = f.readline().rstrip(b"\r\n")
            kind, rest = line[:1], line[1:]
            if kind == b"-":
                raise OSError(rest.decode())
            if kind in (b"+", b":"):
                return rest.decode()
            if kind == b"$":
                n = int(rest)
                return None if n < 0 else f.read(n + 2)[:-2].decode()
            if kind == b"*":
                return [read() for _ in range(int(rest))] if int(rest) >= 0 else None
            raise OSError(f"unexpected reply from redis: {line[:40]!r}")

        if u.password:
            send(*(["AUTH", u.username, u.password] if u.username else ["AUTH", u.password]))
        if u.path.strip("/"):
            send("SELECT", u.path.strip("/"))
        return send(*cmd)


def sink_push(trace):
    """Copy one trace to CTXH_TRACE_SINK (a directory, an http(s) URL or a redis:// URL); failures only warn."""
    sink = env("TRACE_SINK")
    if not sink:
        return
    item = shared_trace(trace)
    try:
        if sink.startswith(("http://", "https://")):
            from urllib.request import Request, urlopen
            req = Request(sink, data=json.dumps(item).encode(), method="POST",
                          headers={"Content-Type": "application/json"})
            urlopen(req, timeout=SINK_TIMEOUT).close()
        elif sink.startswith("redis://"):
            key = f"ctxh:traces:{item['repo']}"
            redis_call(sink, "RPUSH", key, json.dumps(item))
            redis_call(sink, "LTRIM", key, -SINK_KEEP, -1)
        else:
            write_json(Path(sink).expanduser() / item["repo"] / f"{item['session']}.json", item)
    except Exception as e:  # never fail a session over the shared store
        warn_once("sink", f"could not send the trace to CTXH_TRACE_SINK ({type(e).__name__}: {e})")


def sink_pull():
    """This repo's traces from CTXH_TRACE_SINK, or [] when none is configured or it can't be read."""
    sink = env("TRACE_SINK")
    if not sink:
        return []
    rid = repo_id()
    try:
        if sink.startswith(("http://", "https://")):
            from urllib.parse import urlencode
            from urllib.request import urlopen
            with urlopen(f"{sink}{'&' if '?' in sink else '?'}{urlencode({'repo': rid})}", timeout=SINK_TIMEOUT) as r:
                items = json.loads(r.read().decode())
        elif sink.startswith("redis://"):
            items = [json.loads(x) for x in redis_call(sink, "LRANGE", f"ctxh:traces:{rid}", 0, -1) or []]
        else:
            items = [load_json(p) for p in sorted((Path(sink).expanduser() / rid).glob("*.json"))]
    except Exception as e:
        print(f"ctxh: could not read CTXH_TRACE_SINK ({type(e).__name__}: {e}); using local traces only",
              file=sys.stderr)
        return []
    return [t for t in items if isinstance(t, dict) and t.get("repo", rid) == rid]


def record(session, data, label, task, tool=None):
    data.update(session=session, label=label, task=task, recorded_at=time.strftime("%Y-%m-%dT%H:%M:%S"),
                tool=tool or ADAPTER.NAME)
    write_json(METRICS / f"{session}.json", {k: data.get(k) for k in (
        "session", "tool", "label", "task", "recorded_at", "tokens_total", "tokens_uncached", "tokens_main",
        "tokens_sub", "steps", "subagents", "tool_version", "source")})
    if label == "harness":
        trace = {k: data[k] for k in ("session", "task", "recorded_at", "files_read", "files_edited", "commands",
                                      "failed_commands", "ctx_queries", "ctx_misses", "subagents")}
        write_json(TRACES / f"{session}.json", trace)
        sink_push(trace)
    for d in (METRICS, TRACES):  # bounded history: keep the newest records only
        if d.exists():
            for old in sorted(d.glob("*.json"), key=lambda f: f.stat().st_mtime)[:-KEEP_RECORDS]:
                old.unlink(missing_ok=True)


def opt(args, name, default=None):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else default


GATEWAY_KEYS = {  # per-request usage as gateways and provider APIs name it -> ctxh's names
    "input_tokens": ("input_tokens", "prompt_tokens"),
    "output_tokens": ("output_tokens", "completion_tokens"),
    "cache_read_input_tokens": ("cache_read_input_tokens", "cached_tokens", "prompt_tokens_details.cached_tokens"),
    "cache_creation_input_tokens": ("cache_creation_input_tokens",),
}
GATEWAY_SESSION_KEYS = ("session", "session_id", "metadata.session_id", "metadata.session", "trace_id")


def dig(obj, dotted):
    for part in dotted.split("."):
        obj = obj.get(part) if isinstance(obj, dict) else None
    return obj


def gateway_sessions(path: Path):
    """Usage per session from an LLM gateway's request log (JSONL, one request per line)."""
    sessions = defaultdict(lambda: {"tokens_main": Counter(), "requests": 0})
    for line in path.read_text(errors="ignore").splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict):
            continue
        usage = e.get("usage") if isinstance(e.get("usage"), dict) else e
        sid = next((str(v) for k in GATEWAY_SESSION_KEYS if (v := dig(e, k))), None)
        if not sid:
            continue
        s = sessions[sid]
        s["requests"] += 1
        got = {}
        for name, aliases in GATEWAY_KEYS.items():
            got[name] = next(((a, int(v)) for a in aliases if isinstance(v := dig(usage, a), (int, float))), (None, 0))
        if got["input_tokens"][0] == "prompt_tokens":  # OpenAI style: cached tokens are part of prompt_tokens
            got["input_tokens"] = (None, max(0, got["input_tokens"][1] - got["cache_read_input_tokens"][1]))
        for name, (_, n) in got.items():
            s["tokens_main"][name] += n
    out = {}
    for sid, s in sessions.items():
        t = s["tokens_main"]
        out[sid] = {"tokens_main": dict(t), "tokens_sub": {}, "steps": None, "subagents": {}, "tool_version": "",
                    "requests": s["requests"], "source": "gateway",
                    "tokens_total": sum(t.values()),
                    "tokens_uncached": t["input_tokens"] + t["output_tokens"] + t["cache_creation_input_tokens"]}
    return out


def cmd_usage(args):
    if not args:
        sys.exit("ctxh usage <transcript.jsonl> [--label baseline|harness] [--task T]\n"
                 "ctxh usage --gateway <requests.jsonl> --tool <agent> [--label L] [--task T]")
    label, task = opt(args, "--label", "baseline"), opt(args, "--task", env("TASK"))
    if "--gateway" in args:
        log, tool = opt(args, "--gateway"), opt(args, "--tool")
        if not log or not tool:
            sys.exit("ctxh usage --gateway <requests.jsonl> --tool <agent> [--label L] [--task T]")
        found = gateway_sessions(Path(log).expanduser())
        if not found:
            sys.exit(f"ctxh usage: no request in {log} carries a session id ({', '.join(GATEWAY_SESSION_KEYS)})")
        for sid, data in sorted(found.items()):
            record(sid, data, label, task, tool=tool)
            print(f"{tool} {label} {task or ''} {sid}: {data['tokens_total']} tokens total "
                  f"({data['tokens_uncached']} uncached), {data['requests']} requests")
        return
    p = Path(args[0]).expanduser()
    data = parse_transcript(p)
    if data is None:
        sys.exit(f"no transcript at {p}")
    warning = transcript_warning(data)
    if warning and not data["usage_messages"]:
        sys.exit(f"ctxh usage: {warning}")  # an explicit run fails loudly rather than recording zeros
    if warning:
        warn_once("transcript", warning)
    record(p.stem, data, label, task)
    print(f"{label} {task or ''}: {data['tokens_total']} tokens total "
          f"({data['tokens_uncached']} uncached), {data['steps']} tool calls, {len(data['files_read'])} files read")


def cmd_stats(_):
    rows = [load_json(p) for p in METRICS.glob("*.json")] if METRICS.exists() else []
    rows = [r for r in rows if r]
    if not rows:
        print("no metrics yet")
        return

    def med(xs):
        xs = sorted(x for x in xs if x is not None)  # gateway rows have no step count
        return xs[len(xs) // 2] if xs else "-"

    for r in rows:
        r.setdefault("tool", "claude")  # records from before tools were labeled all came from Claude Code
    overhead = [r for r in rows if r.get("task") in OVERHEAD_TASKS]
    work = [r for r in rows if r.get("task") not in OVERHEAD_TASKS]
    by = defaultdict(list)
    for r in work:
        by[(r["tool"], r["label"])].append(r)
    print(f"{'tool':<10}{'label':<10}{'runs':>6}{'median tokens':>16}{'median uncached':>18}{'median steps':>14}")
    for (tool, label), rs in sorted(by.items()):
        print(f"{tool:<10}{label:<10}{len(rs):>6}{med([r['tokens_total'] for r in rs]):>16}"
              f"{med([r['tokens_uncached'] for r in rs]):>18}{med([r.get('steps') for r in rs]):>14}")
    tasks = defaultdict(dict)
    for r in work:
        if r.get("task"):  # harness and baseline are only compared within one tool
            tasks[(r["tool"], r["task"])].setdefault(r["label"], []).append(r["tokens_total"])
    paired = {t: v for t, v in tasks.items() if "harness" in v and "baseline" in v}
    saved = 0
    if paired:
        print("\npaired tasks, median total tokens (harness vs baseline):")
        multi = len({tool for tool, _ in paired}) > 1
        for (tool, t), v in sorted(paired.items()):
            h, b = med(v["harness"]), med(v["baseline"])
            saved += b - h
            name = f"{tool}/{t}" if multi else t
            print(f"  {name}: {h} vs {b}  ({(h - b) / b * 100:+.0f}%)" if b else f"  {name}: {h} vs {b}")
    if overhead:
        cost = sum(r["tokens_total"] for r in overhead)
        print(f"\nharness overhead so far (bootstrap + curation): {cost} tokens")
        if paired and saved > 0:
            per_task = saved / len(paired)
            print(f"average saving {per_task:.0f} tokens/task -> break-even after ~{cost / per_task:.0f} tasks")
        elif paired:
            print("no net saving on paired tasks yet: the harness is not paying for itself on this repo")


def cmd_signals(_):
    traces = [load_json(p) for p in sorted(TRACES.glob("*.json"))] if TRACES.exists() else []
    local = {t.get("session") for t in traces if t}
    shared = [t for t in sink_pull() if t.get("session") not in local]  # a session counts once
    traces = [t for t in traces + shared if t and t.get("task") not in OVERHEAD_TASKS]
    for t in traces:
        for k in ("files_read", "failed_commands", "ctx_queries", "ctx_misses"):
            t.setdefault(k, [])
    if not traces:
        print("no traces yet")
        return
    known = ""
    for p in [MAP, LEARNED, *(CARDS.glob("*.md") if CARDS.exists() else [])]:
        if p.exists():
            known += p.read_text()
    reads = Counter(f for t in traces for f in set(t["files_read"]))
    n_shared = sum(1 for t in traces if t.get("session") not in local)
    print(f"{len(traces)} traces" + (f" ({n_shared} from the shared sink)" if n_shared else ""))
    print("\nfiles needed in >=3 tasks but not mentioned in map/cards/learned:")
    hits = [(n, f) for f, n in reads.items() if n >= 3 and f.rsplit("/", 1)[-1] not in known]
    print("\n".join(f"  {n}x {f}" for n, f in sorted(hits, reverse=True)[:10]) or "  none")
    fails = Counter(re.sub(r"\s+", " ", x["cmd"])[:80] for t in traces for x in t["failed_commands"])
    print("\ncommands that failed in >=2 tasks:")
    print("\n".join(f"  {n}x {c}" for c, n in fails.most_common(10) if n >= 2) or "  none")
    asked = sum(len(t["ctx_queries"]) for t in traces)
    missed = sum(len(t["ctx_misses"]) for t in traces)
    if asked:
        print(f"\nindex queries: {asked}, empty results: {missed} ({missed / asked:.0%})")
    miss = Counter(m for t in traces for m in t["ctx_misses"])
    print("\nindex queries that came back empty (index gap or wrong mental model):")
    print("\n".join(f"  {n}x {c}" for c, n in miss.most_common(10)) or "  none")
    notes = CTX / "tasks" / "notes.md"
    if notes.exists() and notes.read_text().strip():
        print("\ncoder notes pending review: .ctx/tasks/notes.md")


# ---------------------------------------------------------------- init (instruction files for other agents)
BLOCK_BEGIN, BLOCK_END = "<!-- ctx-harness:begin -->", "<!-- ctx-harness:end -->"
INIT_TARGETS = {  # target -> (file, who reads it)
    "agents-md": ("AGENTS.md", "Codex, GitHub Copilot's coding agent and other AGENTS.md readers"),
    "gemini": ("GEMINI.md", "Gemini CLI"),
    "cursor": (".cursor/rules/ctx-harness.mdc", "Cursor"),
    "aider": ("CONVENTIONS.md", "Aider"),
}
INIT_BLOCK = """## Repository context (ctx-harness)

This repo keeps compact, maintained context in `.ctx/`. Use it before exploring:

- Start with `.ctx/map.md` (stack, modules, verified commands, fragile files). If `.ctx/tasks/active.md` exists, read it and continue from its progress log.
- Ask the index before grep: `ctxh q find <symbol>`, `ctxh q rdeps|impact|cochange|tests|owner <file>`, `ctxh q module <file>`. Only the answer enters your context. Grep and read targeted ranges only when the index has no answer.
- Before changing a module, read its card, `.ctx/cards/<module-with-dashes>.md`, and only that one. Gotchas from past tasks are in `.ctx/learned.md`.
- Read the card, then the files it and the map point to, in one batch, and edit. Do not explore beyond them unless they fall short.
- Validate with the verified commands listed in the map.
- Only when the request leaves the design open and no reasonable default exists, write a short plan to `.ctx/tasks/active.md` and ask the user to decide. Do not plan or review as a routine step.
- `.ctx/map.md`, `.ctx/cards/` and `.ctx/learned.md` are maintained by the curation step, not edited during a task.

`ctxh` is the ctx-harness engine (`plugins/ctx-harness/bin/ctxh` in https://github.com/ahmetask/ctx-harness, Python 3 stdlib only); put its `bin/` on `PATH` or run it as `python3 <path>/ctxh`. Full protocol: https://github.com/ahmetask/ctx-harness/blob/main/plugins/ctx-harness/protocol.md"""


def upsert_block(text, block):
    """text with the marked block replaced, or appended when there is none."""
    marked = f"{BLOCK_BEGIN}\n{block}\n{BLOCK_END}"
    start, end = text.find(BLOCK_BEGIN), text.find(BLOCK_END)
    if start != -1 and end > start:
        return text[:start] + marked + text[end + len(BLOCK_END):]
    return (text.rstrip("\n") + "\n\n" if text.strip() else "") + marked + "\n"


def cmd_init(args):
    """Write or update the instructions file of another coding agent so it uses .ctx/ and ctxh q."""
    targets = [t for t in (opt(args, "--target") or "").split(",") if t]
    bad = [t for t in targets if t not in INIT_TARGETS]
    if not targets or bad:
        sys.exit(f"ctxh init --target {'|'.join(INIT_TARGETS)}[,...]" + (f" (unknown: {', '.join(bad)})" if bad else ""))
    for t in targets:
        rel, who = INIT_TARGETS[t]
        path = ROOT / rel
        old = path.read_text() if path.exists() else ""
        if t == "cursor":  # a rule file of its own: front matter makes Cursor apply it to every request
            new = ("---\ndescription: Repository context from ctx-harness (.ctx/ and ctxh q)\nalwaysApply: true\n---\n"
                   + upsert_block(old.split("---\n", 2)[2] if old.startswith("---\n") and old.count("---\n") >= 2
                                  else old, INIT_BLOCK))
        else:
            new = upsert_block(old, INIT_BLOCK)
        if new == old:
            print(f"{rel}: unchanged ({who})")
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(new)
            print(f"{rel}: {'updated' if old else 'created'} ({who})")
        if t == "aider":
            conf = ROOT / ".aider.conf.yml"
            text = conf.read_text() if conf.exists() else ""
            if "CONVENTIONS.md" in text:
                pass
            elif re.search(r"^read\s*:", text, re.M):
                print("  .aider.conf.yml already has a `read:` entry: add CONVENTIONS.md to it so Aider loads the block")
            else:
                conf.write_text((text.rstrip("\n") + "\n" if text.strip() else "") + "read: CONVENTIONS.md\n")
                print("  .aider.conf.yml: added `read: CONVENTIONS.md`")
    if not opted_in():
        print("no .ctx/ yet: build it with `ctxh build-index --verify && ctxh skeleton`, then fill .ctx/map.draft.md "
              "and save it as .ctx/map.md (in Claude Code, /ctx-harness:build does all of this)")


# ---------------------------------------------------------------- prompts (written once, rendered per agent)
PROMPTS = PLUGIN_ROOT / "prompts"
PLACEHOLDER_RX = re.compile(r"\{\{(agent|command|tool):([a-z-]+)\}\}")
ONLY_RX = re.compile(r"\{\{only:([a-z0-9_]+)\}\}")


def render_prompt(text):
    """Fill a neutral prompt for the active agent: {{agent:X}} and {{command:X}} through the adapter's
    AGENT_REF / COMMAND_REF formats, {{tool:ROLE}} through its PROMPT_TOOLS, and a line starting with
    {{only:NAME}} kept only for adapter NAME. Adapters without these get the bare names."""
    kept = []
    for line in text.splitlines(keepends=True):
        m = ONLY_RX.match(line)
        if m and m.group(1) != ADAPTER.NAME:
            continue
        kept.append(line[m.end():] if m else line)
    refs = {"agent": getattr(ADAPTER, "AGENT_REF", "{}"), "command": getattr(ADAPTER, "COMMAND_REF", "{}")}

    def fill(m):
        kind, name = m.groups()
        return getattr(ADAPTER, "PROMPT_TOOLS", {}).get(name, name) if kind == "tool" else refs[kind].format(name)

    return PLACEHOLDER_RX.sub(fill, "".join(kept))


def prompt_sources(kind):
    """[(meta, rendered body)] for prompts/<kind>/*.md. Front matter is `key: value` lines; `tools` is a
    comma list of roles (read, search, shell, write, ctxh) and `manual: true` keeps a skill user-invoked."""
    out = []
    for p in sorted((PROMPTS / kind).glob("*.md")):
        _, head, body = p.read_text().split("---\n", 2)
        meta = dict(line.split(": ", 1) for line in head.strip().splitlines())
        meta["tools"] = [t.strip() for t in meta.get("tools", "").split(",") if t.strip()]
        meta["manual"] = meta.get("manual") == "true"
        out.append((meta, render_prompt(body)))
    return out


def cmd_export(args):
    """Write the active agent's agent and skill files from prompts/, plus anything its adapter packages."""
    if not hasattr(ADAPTER, "render_agent"):
        sys.exit(f"ctxh export: adapter '{ADAPTER.NAME}' does not generate prompt files")
    out = opt(args, "--out") or (str(PLUGIN_ROOT) if getattr(ADAPTER, "EXPORT_IN_PLACE", False) else None)
    if not out:
        sys.exit(f"ctxh export --tool {ADAPTER.NAME} --out DIR")
    out, check = Path(out).resolve(), "--check" in args
    files = {}
    for meta, body in prompt_sources("agents"):
        files.update(ADAPTER.render_agent(meta, body))
    for meta, body in prompt_sources("skills"):
        files.update(ADAPTER.render_skill(meta, body))
    if hasattr(ADAPTER, "package"):
        files.update(ADAPTER.package(PLUGIN_ROOT))
    changed = []
    for rel, content in sorted(files.items()):
        data = content.read_bytes() if isinstance(content, Path) else content.encode()
        if isinstance(content, str) and PLACEHOLDER_RX.search(content):
            sys.exit(f"ctxh export: unfilled placeholder in {rel}")
        dest = out / rel
        if dest.is_file() and dest.read_bytes() == data:
            continue
        changed.append(rel)
        if not check:
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(data)
            if isinstance(content, Path) and os.access(content, os.X_OK):
                dest.chmod(dest.stat().st_mode | 0o111)
    if check:
        print("\n".join(f"differs: {r}" for r in changed) or f"ok: {len(files)} {ADAPTER.LABEL} files match prompts/")
        sys.exit(1 if changed else 0)
    print(f"{ADAPTER.LABEL}: wrote {len(changed)} of {len(files)} files to {out}")


# ---------------------------------------------------------------- hooks
def refresh_in_background():
    """Start a detached re-index; the session never waits for it."""
    lock = TMP / "index.lock"
    try:
        if lock.exists() and time.time() - lock.stat().st_mtime < 600:
            return
        TMP.mkdir(parents=True, exist_ok=True)
        lock.write_text(str(os.getpid()))
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "build-index", "--quiet", "--release-lock"],
                         cwd=ROOT, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True,
                         env={**os.environ, "CTXH_TOOL": ADAPTER.NAME, **ADAPTER.child_env(ROOT)})
    except OSError:
        pass


def plan_resume_note(plan: Path, source="compact"):
    """For a session that lost its history to compaction: which plan it is on and where the log left off."""
    text = plan.read_text()
    title = next((l.lstrip("# ").strip() for l in text.splitlines() if l.startswith("#")), "")
    log = re.split(r"^##\s+Progress log\s*$", text, flags=re.M)
    entries = [l for l in log[1].splitlines() if l.strip().startswith(("-", "*"))] if len(log) > 1 else []
    why = "Context was compacted mid-task" if source == "compact" else "This session resumed mid-task"
    note = [f"{why}. You are working on the plan in .ctx/tasks/active.md"
            + (f" ({title})" if title else "") + ". Continue from its progress log; do not re-plan finished steps."]
    if entries:
        note.append(f"Last {min(len(entries), PLAN_TAIL)} progress entries:\n" + "\n".join(entries[-PLAN_TAIL:]))
    else:
        note.append("Its progress log is empty: re-read the plan before continuing.")
    return "\n".join(note)


LEDGER_FILES = 6   # edited files named in the ledger
LEDGER_FAILS = 3   # failed commands named in the ledger


def session_ledger(path: Path):
    """What this session did so far, at most 10 lines, or None when it edited nothing and ran nothing.

    A pure function of the transcript's trace (no model call): the compaction summary keeps the gist
    but loses exact details such as which files were already edited and which command last failed."""
    trace = ADAPTER.read_session(path) if path else None
    calls = [c for c in trace["calls"] if c["side"] == "main"] if trace else []
    files = session_edits(path)["files"] if calls else []
    shell = [c for c in calls if c["kind"] == "shell"]
    if not files and not shell:
        return None
    first_line = lambda c: (c["output"].strip().splitlines() or ["(no output)"])[0][:120]
    out = ["Session ledger (from the transcript, before the context was cut):"]
    if files:
        more = f" and {len(files) - LEDGER_FILES} more" if len(files) > LEDGER_FILES else ""
        out.append(f"- Code files edited, in order: {', '.join(files[:LEDGER_FILES])}{more}.")
    verified = [c["cmd"] for c in (load_json(COMMANDS, {}) or {}).get("commands", []) if c.get("verified")]
    ran = [c for c in shell if any(v in c["command"] for v in verified)]
    if ran:
        last = ran[-1]
        state = f"FAILED: {first_line(last)}" if last["error"] else "passed"
        out.append(f"- Last verified command run: `{last['command'][:100]}` {state}.")
    failed = [c for c in shell if c["error"]][-LEDGER_FAILS:]
    if failed:
        out.append("- Last failed commands:")
        out += [f"  - `{c['command'][:100]}` -> {first_line(c)}" for c in failed]
    agents = Counter(str(c["agent"] or "general") for c in calls if c["kind"] == "subagent")
    if agents:
        out.append("- Subagents called: " + ", ".join(f"{k} x{n}" for k, n in agents.items()) + ".")
    return "\n".join(out)


def cmd_hook_start(_):
    event = ADAPTER.read_event(sys.stdin) or {}
    if env("DISABLED") == "1":
        return
    if not opted_in():
        if (ROOT / ".git").exists():
            ADAPTER.emit_context(render_prompt("ctx-harness: this repo has no harness context (.ctx/). "
                                               "If the user wants it, the build skill ({{command:build}}) creates it."))
        return
    if event.get("source") in ("compact", "clear") and event.get("session"):
        (TMP / "hints" / f"{event['session']}.json").unlink(missing_ok=True)  # the leads left the context
    out = []
    proto = PROTOCOL_OVERRIDE if PROTOCOL_OVERRIDE.exists() else PROTOCOL_DEFAULT
    if proto.exists():
        out.append(render_prompt(proto.read_text()).strip())
    if MAP.exists():
        out.append(MAP.read_text().strip())
    else:
        out.append(render_prompt("The repo map is missing: run the build skill ({{command:build}}) before non-trivial work."))
    g = load_json(GRAPH)
    if g is None or index_lag(g):
        refresh_in_background()  # the index is a derived cache; cards still need the curator
    stale = stale_report(include_index=False)
    if stale:
        out.append("Context freshness (the curator fixes this after merge; do not edit cards yourself):\n"
                   + "\n".join(f"- {x}" for x in stale))
    active = CTX / "tasks" / "active.md"
    if active.exists() and active.read_text().strip():
        if event.get("source") in ("compact", "resume"):
            out.append(plan_resume_note(active, event["source"]))
        else:
            out.append("Active plan exists: .ctx/tasks/active.md (read it first).")
    if event.get("source") in ("compact", "resume") and event.get("transcript"):
        ledger = session_ledger(event["transcript"])
        if ledger:
            out.append(ledger)
    ADAPTER.emit_context("\n\n".join(out))


def gate_on(name):
    """The Stop-hook gates are opt-in (CTXH_PLAN_GATE=1, CTXH_REVIEW_GATE=1): each costs a subagent and a turn."""
    return env(name) == "1"


HINT_MIN_SCORE = 1.4  # BM25 of the best hit: below this the match is a coincidence of words, not a lead
HINT_HITS = 3
HINT_MIN_TERMS = 5  # "commit this and open a pr" has words but no subject


def prompt_hint(prompt, session=None):
    """Starting points for this request, from `q search` on its words, or None when the match is weak.

    Silent on small repos (two `cat`s load everything), on prompts too short to search, and with
    CTXH_HINTS=0. Costs about 100 tokens when it fires. With a session, leads and cards already
    shown are left out (they are still in context until a compact or clear), and nothing new means silence."""
    if env("HINTS") == "0" or not prompt or len(terms(prompt)) < HINT_MIN_TERMS:
        return None
    g = load_json(GRAPH)
    if not g or sum(1 for n in g["files"].values() if n["role"] == "src") < SMALL_REPO_FILES:
        return None
    found = [h for h in keyword_search(g, prompt, HINT_HITS * 3) if g["files"][h[1]]["role"] != "docs"][:HINT_HITS]
    if not found or found[0][0] < HINT_MIN_SCORE:
        return None
    state = TMP / "hints" / f"{session}.json" if session else None
    seen = (load_json(state, {}) or {}) if state else {}
    leads = [f"{f}:{line} {label}" for _, f, line, label in found]
    new = [l for l in leads if l not in seen.get("leads", [])]
    card = CARDS / (g["files"][found[0][1]]["module"].replace("/", "-") + ".md")
    card_new = card.exists() and str(card) not in seen.get("cards", [])
    if not new and not card_new:
        return None
    if state:
        write_json(state, {"leads": seen.get("leads", []) + new,
                           "cards": seen.get("cards", []) + ([str(card)] if card_new else [])})
    tail = f" Card: {card.relative_to(ROOT)}." if card_new else ""
    return f"ctx-harness: keyword matches for this request (leads, not answers): {'; '.join(new)}.{tail}" if new else \
        f"ctx-harness: relevant card for this request: {card.relative_to(ROOT)}."


def cmd_hook_prompt(_):
    """With a gate on, recite its rule right where the next decision is made; always point at an active plan."""
    event = ADAPTER.read_event(sys.stdin) or {}
    if env("DISABLED") == "1" or not opted_in():
        return
    lines = []
    hint = prompt_hint(event.get("prompt"), event.get("session"))
    if hint:
        lines.append(hint)
    if gate_on("PLAN_GATE") or gate_on("REVIEW_GATE"):  # the reminder exists to avoid a gate's blocked turn
        rules = []
        if gate_on("PLAN_GATE"):
            rules.append("if this request means changing 3+ files and leaves the scope or design open, call "
                         "{{agent:planner}} first; if it already says what to change, write a short plan to "
                         "`.ctx/tasks/active.md` yourself.")
        if gate_on("REVIEW_GATE"):
            rules.append("Before finishing any code change, run {{agent:reviewer}}.")
        lines.append(render_prompt("ctx-harness: " + " ".join(rules)
                                   + "\n{{only:claude}}Run subagents in the foreground (`run_in_background: false`) "
                                     "and wait for their answer.").rstrip("\n"))
    active = CTX / "tasks" / "active.md"
    if active.exists() and active.read_text().strip():
        lines.append("Active plan: .ctx/tasks/active.md")
    if lines:
        ADAPTER.emit_context("\n".join(lines))


def session_edits(path: Path):
    """What the gates need from a transcript: the code the main session changed, and who it called.

    files: distinct repo-relative code files edited, in the order first touched.
    last_edit: id of the last code edit's tool call (what both gates key their block-once state on).
    reviewed_after: a reviewer subagent ran after that edit. planner: a planner subagent ran, or the
    session wrote .ctx/tasks/active.md itself (that plan may be filed under done/ by the time it stops).
    """
    info = {"files": [], "last_edit": None, "reviewed_after": False, "planner": False}
    trace = ADAPTER.read_session(path)
    for call in trace["calls"] if trace else []:
        if call["side"] != "main":
            continue
        if call["kind"] == "edit":
            f = call["path"]
            rel = os.path.relpath(f, ROOT) if os.path.isabs(f) else f
            if rel == os.path.join(".ctx", "tasks", "active.md"):
                info["planner"] = True
            elif f and not rel.startswith((".ctx", "..")) and lang_of(rel):
                info["last_edit"], info["reviewed_after"] = call["id"], False
                if rel not in info["files"]:
                    info["files"].append(rel)
        elif call["kind"] == "subagent":
            kind = str(call["agent"] or "")
            if kind.endswith("reviewer"):
                info["reviewed_after"] = True
            elif kind.endswith("planner"):
                info["planner"] = True
    return info


def unreviewed_edit(path: Path):
    """Id of the last code edit in the main session that no reviewer call came after, else None."""
    info = session_edits(path)
    return None if info["reviewed_after"] else info["last_edit"]


def plan_gate_reason(info):
    """Why this session needed a plan and does not have one, else None."""
    if len(info["files"]) < PLAN_GATE_FILES or info["planner"]:
        return None
    active = CTX / "tasks" / "active.md"  # a finished task moves its plan to done/, hence the planner check
    if active.exists() and active.read_text().strip():
        return None
    shown = ", ".join(info["files"][:3])
    return (f"ctx-harness plan gate: {len(info['files'])} code files changed in this session ({shown}"
            f"{', ...' if len(info['files']) > 3 else ''}) and there is no plan in .ctx/tasks/active.md. "
            + render_prompt("Write the plan to `.ctx/tasks/active.md` (call {{agent:planner}} when the scope "
                            "was open) covering what you have done and what is left, and keep working from it. "
                            "If the user explicitly said to skip planning, say so and finish."))


def gate_once(session, key, value):
    """True the first time a gate fires for a given state; both gates share one state file."""
    state = TMP / "gates" / f"{session}.json"
    seen = load_json(state, {}) or {}
    if seen.get(key) == value:
        return False
    seen[key] = value
    write_json(state, seen)
    return True


def cmd_hook_stop(_):
    event = ADAPTER.read_event(sys.stdin)
    if not event or not opted_in() or not event["transcript"]:
        return
    path = event["transcript"]
    data = parse_transcript(path)
    if not data:
        return
    disabled = env("DISABLED") == "1"
    session = event["session"] or path.stem
    warning = transcript_warning(data)
    if warning:
        warn_once("transcript", warning)
    if data["usage_messages"]:  # a transcript the parser can't read is skipped, not stored as zeros
        record(session, data, "baseline" if disabled else "harness", env("TASK"))
    if disabled:
        return
    info = session_edits(path)
    if gate_on("PLAN_GATE"):  # plan first, review second: the same order the protocol asks for
        reason = plan_gate_reason(info)
        if reason and gate_once(session, "blocked_plan", info["last_edit"]):
            ADAPTER.emit_block(reason)
            return
    if info["reviewed_after"] and info["last_edit"] and REVIEWS.exists():
        record_reviews()  # the reviewer ran after the last edit: that is the record review-check looks for
    if not gate_on("REVIEW_GATE"):
        return
    edit = None if info["reviewed_after"] else info["last_edit"]
    if edit and gate_once(session, "blocked_edit", edit):  # block once per edit, never loop
        ADAPTER.emit_block(render_prompt(
            "ctx-harness review gate: code changed since the last {{agent:reviewer}} run. Run the reviewer "
            "on the diff (at most 2 rounds), record its findings in the plan's progress log, run `ctxh stale`, "
            "then finish. If the user explicitly said to skip review, say so and finish."))


# ---------------------------------------------------------------- review record (gate outside the agent)
PRE_COMMIT_MARK = "# ctx-harness review-check"


def changed_code(mode="worktree", base=None):
    """(path, blob id) of code files changed: in the working tree, the index, or REF...HEAD; deletions skipped."""
    if mode == "base":
        code, out, err = sh(["git", "diff", "--name-only", "--diff-filter=d", f"{base}...HEAD"])
    elif mode == "staged":
        code, out, err = sh(["git", "diff", "--cached", "--name-only", "--diff-filter=d"])
    else:
        code, out, err = sh(["git", "diff", "HEAD", "--name-only", "--diff-filter=d"])
        if code == 0:
            _, untracked, _ = sh(["git", "ls-files", "--others", "--exclude-standard"])
            out += untracked
    if code != 0:
        sys.exit(f"ctxh: git diff failed: {err.strip()}")
    rules = ignore_rules()
    paths = sorted({f for f in out.splitlines() if f and not f.startswith((".ctx/", ".claude/"))
                    and not ignored(f, rules) and (ROOT / f).is_file() and lang_of(f)})
    rev = {"base": "HEAD:", "staged": ":"}.get(mode)
    out = []
    for f in paths:
        code, sha, _ = sh(["git", "rev-parse", rev + f] if rev else ["git", "hash-object", "--", f])
        out.append((f, sha.strip() if code == 0 else ""))
    return out


def record_reviews(paths=None):
    """Stamp the current content of the given (default: all changed) code files as reviewed."""
    if paths is not None:
        rules = ignore_rules()
        files = [(f, sh(["git", "hash-object", "--", f])[1].strip()) for f in paths
                 if (ROOT / f).is_file() and lang_of(f) and not ignored(f, rules)]
    else:
        files = changed_code()
    data = load_json(REVIEWS, {}) or {}
    data.update({f: sha for f, sha in files if sha})
    REVIEWS.parent.mkdir(parents=True, exist_ok=True)
    REVIEWS.write_text(json.dumps(data, indent=1, sort_keys=True) + "\n")  # committed: stable, diff-friendly
    return [f for f, sha in files if sha]


def cmd_review_record(args):
    rels = [os.path.relpath(os.path.abspath(a), ROOT) for a in args]
    done = record_reviews(rels or None)
    print(f"recorded review of {len(done)} code files in .ctx/reviews.json" + (": " + ", ".join(done) if done else ""))


def cmd_review_check(args):
    if "--install-hook" in args:
        hook = ROOT / ".git" / "hooks" / "pre-commit"
        if hook.exists() and PRE_COMMIT_MARK not in hook.read_text():
            sys.exit(f"{hook.relative_to(ROOT)} exists and is not ctx-harness's: add `ctxh review-check --staged` to it")
        hook.parent.mkdir(parents=True, exist_ok=True)
        hook.write_text(f"#!/bin/sh\n{PRE_COMMIT_MARK}\nexec \"{sys.executable}\" \"{Path(__file__).resolve()}\" "
                        "review-check --staged\n")
        hook.chmod(0o755)
        if not REVIEWS.exists():
            record_reviews([])
        print(f"installed {hook.relative_to(ROOT)}; record reviews with `ctxh review-record`")
        return
    if env("REVIEW_GATE", "1") == "0":
        return
    mode, base = ("base", opt(args, "--base")) if "--base" in args else ("staged" if "--staged" in args else "worktree", None)
    if mode == "base" and not base:
        sys.exit("ctxh review-check --base <ref>")
    reviewed = load_json(REVIEWS, {}) or {}
    missing = [f for f, sha in changed_code(mode, base) if reviewed.get(f) != sha]
    if not missing:
        print("ok: every changed code file has a review record")
        return
    print(f"{len(missing)} changed code files have no review of their current content:")
    print("\n".join(f"  {f}" for f in missing))
    print("Review the diff, then run `ctxh review-record` (Claude Code sessions record it when the reviewer runs). "
          "CTXH_REVIEW_GATE=0 skips this check.")
    sys.exit(1)


def cmd_version(_):
    print(f"ctxh {VERSION} (plugin root: {PLUGIN_ROOT}, repo root: {ROOT}, adapter: {ADAPTER.NAME})")


COMMANDS_MAP = {
    "build-index": cmd_build_index, "skeleton": cmd_skeleton, "q": cmd_q, "anchor": cmd_anchor,
    "stale": cmd_stale, "check": cmd_check, "ready": cmd_ready, "card-draft": cmd_card_draft, "signals": cmd_signals, "usage": cmd_usage,
    "stats": cmd_stats, "add-command": cmd_add_command, "hook-start": cmd_hook_start, "hook-stop": cmd_hook_stop,
    "hook-prompt": cmd_hook_prompt, "version": cmd_version, "init": cmd_init,
    "review-record": cmd_review_record, "review-check": cmd_review_check, "export": cmd_export,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS_MAP:
        print(__doc__)
        sys.exit(0 if len(sys.argv) < 2 else 2)
    try:
        COMMANDS_MAP[sys.argv[1]](sys.argv[2:])
    except BrokenPipeError:
        pass
